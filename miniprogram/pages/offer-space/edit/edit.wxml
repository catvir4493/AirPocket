<import src="../release/bag-form.wxml" />

<view class="page no-bottom-nav edit-page has-sticky-action">
  <view class="eyebrow page-eyebrow fade-up">Edit</view>
  <view class="page-title fade-up">编辑行李额</view>
  <view class="page-subtitle fade-up delay-1">只有还没被绑定过的行李额可以修改。</view>

  <view wx:if="{{loading}}" class="edit-skeleton">
    <view class="edit-skeleton-card skeleton-shine"></view>
    <view class="edit-skeleton-card short skeleton-shine"></view>
  </view>

  <view wx:else class="form fade-up delay-2">
    <template is="bag-form" data="{{form, focusedField, minDate, dateText, caseWeightText, quickWeights, specialItemOptions, allowedTags, restrictedTags, tagDraft, preview, roll}}" />
  </view>

  <view wx:if="{{!loading}}" class="sticky-action action-bar">
    <view class="action-summary">
      <view class="action-route">{{summary.route}}</view>
      <view class="action-detail {{summary.ready ? 'ready' : ''}}">{{summary.detail}}</view>
    </view>
    <button class="primary-button action-button {{saved ? 'success' : ''}} {{summary.ready || saved ? '' : 'dim'}}" loading="{{submitting}}" disabled="{{submitting || saved}}" bindtap="submitBag">{{saved ? '✓ 已保存' : '保存'}}</button>
  </view>
</view>
<ap-stamp show="{{saved ? true : false}}" text="已保存" />
<ap-toast id="ap-toast" />
