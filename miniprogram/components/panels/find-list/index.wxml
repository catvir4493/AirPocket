<view class="find-panel">
  <view class="route-overview fade-up delay-1">
    <view class="ro-head">
      <text class="eyebrow ro-eyebrow">{{overview.hasRoute ? '最热路线' : 'AirPocket'}}</text>
      <view class="ro-live"><view class="ro-live-dot"></view>实时</view>
    </view>
    <view class="ro-route">
      <text class="ro-city">{{overview.from}}</text>
      <view class="ro-line">
        <view class="ro-line-dash"></view>
        <view class="ro-plane"><ap-icon name="plane" size="{{34}}" color="#fff51f" stroke="{{1.6}}" /></view>
      </view>
      <text class="ro-city right">{{overview.to}}</text>
    </view>
    <view class="ro-grid">
      <view class="ro-cell">
        <view class="eyebrow ro-label">Available</view>
        <view class="ro-value"><text class="num">{{overview.count}}</text><text class="ro-unit">个</text></view>
      </view>
      <view class="ro-cell">
        <view class="eyebrow ro-label">Next</view>
        <view class="ro-value"><text class="num">{{overview.next}}</text></view>
      </view>
      <view class="ro-cell">
        <view class="eyebrow ro-label">Max</view>
        <view class="ro-value"><text class="num">{{overview.max}}</text><text class="ro-unit">kg</text></view>
      </view>
    </view>
  </view>

  <view class="bag-list-header fade-up delay-2">
    <view class="bag-list-title">可用行李额 · <block wx:for="{{[bags.length]}}" wx:key="*this"><text class="count-swap">{{item}}</text></block></view>
    <button class="filter-entry {{hasActiveFilters ? 'active' : ''}}" bindtap="openFilters"><ap-icon name="filter" size="{{26}}" stroke="{{2.2}}" color="{{hasActiveFilters ? '#1c1c1a' : '#55534c'}}" /><text>筛选</text><view wx:if="{{hasActiveFilters}}" class="filter-dot"></view></button>
  </view>

  <view wx:if="{{loading}}" class="bag-skeleton-list">
    <view wx:for="{{[0, 1, 2]}}" wx:key="*this" class="bag-skeleton skeleton-shine">
      <view class="bag-skeleton-line wide"></view>
      <view class="bag-skeleton-line short"></view>
    </view>
  </view>

  <block wx:elif="{{bags.length}}">
    <view wx:for="{{bags}}" wx:key="_id" class="bag-card list-enter {{item.cardReverse ? 'reverse' : ''}}" style="animation-delay: {{index < 8 ? index * 45 : 0}}ms" hover-class="bag-card-hover" hover-stay-time="80" data-id="{{item._id}}" bindtap="openDetail">
      <view class="bag-card-inner">
        <view class="bag-card-top">
          <text wx:if="{{!item.cardReverse}}" class="bag-date">{{item.listDateText}}</text>
          <text class="bag-route">{{item.listRouteText}}</text>
          <text wx:if="{{item.cardReverse}}" class="bag-date">{{item.listDateText}}</text>
        </view>
        <view class="bag-card-bottom">
          <text wx:if="{{!item.cardReverse}}" class="bag-weight">{{item.listWeightText}}</text>
          <text class="bag-tags">{{item.listTagsText}}</text>
          <text wx:if="{{item.cardReverse}}" class="bag-weight">{{item.listWeightText}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <image class="empty-art" src="/images/empty-bag-large.png" mode="aspectFit" />
    <view>{{emptyMessage}}</view>
  </view>

  <view wx:if="{{filterPanelOpen}}" class="filter-drawer {{filterPanelClosing ? 'closing' : ''}}">
    <view class="filter-mask sheet-mask-anim" bindtap="closeFilters"></view>
    <view class="filter-sheet sheet-panel-anim">
      <view class="sheet-grab"></view>
      <view class="filter-sheet-header">
        <view class="filter-sheet-title">筛选</view>
        <button class="filter-sheet-close" bindtap="closeFilters">关闭</button>
      </view>

      <view class="filter-panel">
        <view class="filter-row">
          <view class="filter-field">
            <view class="filter-label">出发地</view>
            <input class="filter-input" value="{{filters.fromCity}}" data-field="fromCity" bindinput="onFilterInput" placeholder="出发地" />
          </view>
          <view class="filter-field">
            <view class="filter-label">目的地</view>
            <input class="filter-input" value="{{filters.toCity}}" data-field="toCity" bindinput="onFilterInput" placeholder="目的地" />
          </view>
        </view>

        <view class="filter-row">
          <view class="filter-field">
            <view class="filter-label">日期</view>
            <picker mode="date" value="{{filters.departureDate}}" bindchange="onFilterDateChange">
              <view class="filter-picker {{filters.departureDate ? '' : 'placeholder'}}">{{filters.departureDate || '选择日期'}}</view>
            </picker>
          </view>
          <view class="filter-field">
            <view class="filter-label">排序</view>
            <picker mode="selector" range="{{sortOptions}}" range-key="label" value="{{sortIndex}}" bindchange="onSortChange">
              <view class="filter-picker">{{currentSortLabel}}</view>
            </picker>
          </view>
        </view>

        <view class="filter-type-row">
          <button wx:for="{{spaceTypeOptions}}" wx:key="value" class="filter-type {{filters.spaceType === item.value ? 'active' : ''}}" data-type="{{item.value}}" bindtap="selectSpaceType">{{item.label}}</button>
        </view>

        <button class="clear-filter" bindtap="clearFilters">清空筛选</button>
      </view>
    </view>
  </view>
</view>
