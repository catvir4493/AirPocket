@import "../../find-bags/home/home.wxss";

.offer-menu {
  padding: 26rpx 8rpx 0;
  border-top: 1rpx solid #eeeeee;
}

.offer-menu-title {
  margin-bottom: 18rpx;
  color: #666666;
  font-size: 26rpx;
  font-weight: 800;
}

.offer-menu-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0 34rpx;
}

.offer-menu-item::after {
  content: "";
  position: absolute;
  top: 29rpx;
  bottom: -29rpx;
  left: 5rpx;
  width: 1rpx;
  background: rgba(34, 34, 34, 0.18);
}

.offer-menu-item:last-child::after {
  display: none;
}

.offer-menu-dot {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin: 16rpx 28rpx 0 0;
  border-radius: 50%;
  background: #222222;
}

.offer-menu-name {
  color: #303030;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.25;
}

.offer-menu-desc {
  margin-top: 8rpx;
  color: #9b9b9b;
  font-size: 23rpx;
}
