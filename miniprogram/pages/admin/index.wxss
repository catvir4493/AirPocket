.admin-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin: 28rpx 0;
}

.summary-item {
  box-sizing: border-box;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #f6f6f3;
}

.summary-item:first-child {
  background: #2f2f2f;
}

.summary-item:first-child .summary-number {
  color: #fff51f;
}

.summary-item:first-child .summary-label {
  color: #cfcfcf;
}

.summary-number {
  color: #111111;
  font-variant-numeric: tabular-nums;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-label {
  margin-top: 8rpx;
  color: #666666;
  font-size: 24rpx;
}

.filter-panel {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f6f6f3;
}

.admin-search {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #111111;
  font-size: 26rpx;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.filter-picker {
  flex: 1;
}

.filter-value {
  box-sizing: border-box;
  min-height: 68rpx;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #333333;
  font-size: 23rpx;
  line-height: 1.25;
}

.reset-button {
  min-height: 64rpx;
  margin-top: 16rpx;
  border: 1rpx solid #2f2f2f;
  border-radius: 999rpx;
  background: transparent;
  color: #2f2f2f;
  font-size: 24rpx;
  font-weight: 800;
}

.desk-section {
  margin-top: 34rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #111111;
  font-size: 32rpx;
  font-weight: 900;
}

.section-count {
  min-width: 52rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #2f2f2f;
  color: #fff51f;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.work-card,
.bag-card {
  margin-bottom: 18rpx;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #f6f6f3;
}

.pill.status-cancelled {
  background: #ececec;
  color: #777777;
}

.pill.status-completed,
.pill.status-delivered_to_carrier {
  background: #2f2f2f;
  color: #fff51f;
}

.admin-skeleton-card {
  height: 260rpx;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
  background: #f4f4f1;
}

.work-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.work-code {
  color: #111111;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.work-route {
  margin-top: 6rpx;
  color: #555555;
  font-size: 24rpx;
  line-height: 1.35;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.info-label {
  color: #8a8a8a;
  font-size: 21rpx;
  font-weight: 700;
}

.info-value {
  margin-top: 4rpx;
  color: #222222;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-word;
}

.sensitive-block {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.sensitive-label {
  color: #666666;
  font-size: 22rpx;
  font-weight: 800;
}

.sensitive-value {
  margin-top: 8rpx;
  color: #111111;
  font-size: 25rpx;
  line-height: 1.45;
  word-break: break-word;
}

.admin-actions {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx -6rpx 0;
}

.status-button {
  box-sizing: border-box;
  min-height: 56rpx;
  margin: 8rpx 6rpx 0;
  padding: 0 16rpx;
  border: 1rpx solid #cfcfcf;
  border-radius: 999rpx;
  background: #ffffff;
  color: #333333;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.status-button {
  transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
}

.status-button.active {
  border-color: #2f2f2f;
  background: #2f2f2f;
  color: #fff51f;
  animation: ap-pop 320ms var(--ease-spring);
}

.bag-meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx 16rpx;
  margin-top: 16rpx;
  color: #333333;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.audit-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #d4d4d4;
}

.audit-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.audit-target {
  color: #111111;
  font-size: 25rpx;
  font-weight: 900;
}

.audit-time,
.audit-actor {
  color: #777777;
  font-size: 22rpx;
  line-height: 1.4;
}

.audit-status {
  margin-top: 8rpx;
  color: #8a7d00;
  font-size: 24rpx;
  font-weight: 800;
}

.compact {
  margin-top: 14rpx;
  padding: 28rpx;
}
