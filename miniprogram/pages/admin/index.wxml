<view class="page admin-page">
  <view class="eyebrow page-eyebrow fade-up">Admin Desk</view>
  <view class="page-title fade-up">后台运营</view>
  <view class="page-subtitle fade-up delay-1">处理绑定、查看地址与联系方式、推进订单状态。</view>

  <view class="desk-stats fade-up delay-1">
    <view class="desk-stat hot">
      <view class="desk-stat-value num">{{summaryView.pendingCount}}</view>
      <view class="desk-stat-label">待处理</view>
    </view>
    <view class="desk-stat">
      <view class="desk-stat-value num">{{summaryView.todayNewCount}}</view>
      <view class="desk-stat-label">今日新增</view>
    </view>
    <view class="desk-stat">
      <view class="desk-stat-value num">{{summaryView.bagCount}}</view>
      <view class="desk-stat-label">行李额</view>
    </view>
    <view class="desk-stat">
      <view class="desk-stat-value num">{{summaryView.bindingCount}}</view>
      <view class="desk-stat-label">绑定</view>
    </view>
  </view>

  <view class="desk-filter fade-up delay-2">
    <view class="desk-search">
      <ap-icon name="search" size="{{28}}" stroke="{{2.2}}" color="ink-3" />
      <input class="desk-search-input" value="{{searchKeyword}}" bindinput="onSearchInput" placeholder="搜索编号、微信号、城市、地址" placeholder-class="placeholder" />
    </view>
    <view class="desk-filter-row">
      <picker class="desk-chip-picker" mode="selector" range="{{bindingFilterOptions}}" range-key="label" value="{{bindingFilterIndex}}" bindchange="onBindingFilterChange">
        <view class="desk-chip"><text class="desk-chip-key">绑定</text>{{bindingFilterLabel}}<text class="desk-chip-caret">▾</text></view>
      </picker>
      <picker class="desk-chip-picker" mode="selector" range="{{bagFilterOptions}}" range-key="label" value="{{bagFilterIndex}}" bindchange="onBagFilterChange">
        <view class="desk-chip"><text class="desk-chip-key">行李额</text>{{bagFilterLabel}}<text class="desk-chip-caret">▾</text></view>
      </picker>
      <view class="desk-reset" bindtap="resetFilters">重置</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="desk-section">
    <view wx:for="{{[0, 1]}}" wx:key="*this" class="admin-skeleton-card skeleton-shine"></view>
  </view>
  <view wx:elif="{{errorMessage}}" class="empty-state">{{errorMessage}}</view>

  <view wx:else class="content-in">
    <view class="rl-sec"><text class="rl-sec-no">1</text><text>绑定工作台</text><text class="desk-count num">{{visibleBindings.length}}</text></view>
    <view wx:if="{{visibleBindings.length}}">
      <view wx:for="{{visibleBindings}}" wx:key="_id" class="desk-card list-enter" style="animation-delay: {{index < 6 ? index * 35 : 0}}ms">
        <view class="desk-card-top">
          <text class="desk-code num">#{{item.bagNo}}</text>
          <text class="desk-amount">{{item.amountText}}</text>
          <view wx:for="{{[item.status]}}" wx:for-item="pillStatus" wx:key="*this" class="pill status-{{pillStatus}} {{flipId === item._id ? 'pill-flip' : ''}}">{{item.statusText}}</view>
        </view>
        <view class="desk-route">
          <text class="desk-city">{{item.fromCity}}</text>
          <view class="desk-line"><view class="desk-dash"></view><view class="desk-plane"><ap-icon name="plane" size="{{24}}" color="ink" /></view></view>
          <text class="desk-city right">{{item.toCity}}</text>
        </view>
        <view class="desk-date num">{{item.departureDate}}</view>

        <view class="desk-rows">
          <view class="desk-row"><text class="desk-label">需要的人微信</text><text class="desk-value">{{item.senderWechat || "-"}}</text></view>
          <view class="desk-row"><text class="desk-label">带货者微信</text><text class="desk-value">{{item.carrierWechat || "-"}}</text></view>
          <view class="desk-row"><text class="desk-label">物品</text><text class="desk-value">{{item.itemDescription || "-"}}</text></view>
          <view class="desk-row"><text class="desk-label">特殊物品</text><text class="desk-value">{{item.requestedSpecialItemsText}}</text></view>
          <view class="desk-row"><text class="desk-label">提交时间</text><text class="desk-value num">{{item.createdAtText || "-"}}</text></view>
          <view class="desk-row"><text class="desk-label">锁单截止</text><text class="desk-value num">{{item.lockDeadlineText || "-"}}</text></view>
        </view>

        <view class="desk-private">
          <view class="desk-private-head"><ap-icon name="lock" size="{{22}}" stroke="{{2.2}}" color="ink-3" /><text>仅后台可见</text></view>
          <view class="desk-private-item">
            <view class="desk-label">取货地址</view>
            <view class="desk-private-value">{{item.pickupAddress || "-"}}</view>
          </view>
          <view class="desk-private-item">
            <view class="desk-label">目的地收件</view>
            <view class="desk-private-value">{{item.receiverName || "-"}} · {{item.receiverPhone || "-"}}</view>
            <view class="desk-private-value">{{item.deliveryAddress || "-"}}</view>
          </view>
          <view class="desk-private-item">
            <view class="desk-label">带货者收货地址</view>
            <view class="desk-private-value">{{item.carrierReceiveAddress || "-"}}</view>
          </view>
        </view>

        <scroll-view scroll-x class="desk-actions" enhanced show-scrollbar="{{false}}">
          <view class="desk-actions-inner">
            <view wx:for="{{bindingStatuses}}" wx:for-item="statusOption" wx:key="value" class="desk-status {{item.status === statusOption.value ? 'active' : ''}}" data-id="{{item._id}}" data-status="{{statusOption.value}}" bindtap="updateBindingStatus">{{statusOption.label}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
    <view wx:else class="empty-state compact">当前筛选下没有绑定。</view>

    <view class="rl-sec"><text class="rl-sec-no">2</text><text>行李额</text><text class="desk-count num">{{bags.length}}</text></view>
    <view wx:if="{{bags.length}}">
      <view wx:for="{{bags}}" wx:key="_id" class="desk-card list-enter" style="animation-delay: {{index < 6 ? index * 35 : 0}}ms">
        <view class="desk-card-top">
          <text class="desk-code num">#{{item.bagNo}}</text>
          <text class="desk-amount">{{item.spaceTypeText}}</text>
          <view wx:for="{{[item.status]}}" wx:for-item="pillStatus" wx:key="*this" class="pill status-{{pillStatus}} {{flipId === item._id ? 'pill-flip' : ''}}">{{item.statusText}}</view>
        </view>
        <view class="desk-route">
          <text class="desk-city">{{item.fromCity}}</text>
          <view class="desk-line"><view class="desk-dash"></view><view class="desk-plane"><ap-icon name="plane" size="{{24}}" color="ink" /></view></view>
          <text class="desk-city right">{{item.toCity}}</text>
        </view>
        <view class="desk-date num">{{item.departureDate}} · {{item.flightNo || "-"}}</view>

        <view class="desk-rows">
          <view class="desk-row"><text class="desk-label">空间</text><text class="desk-value">{{item.spaceSummaryText}}</text></view>
          <view class="desk-row"><text class="desk-label">绑定数</text><text class="desk-value num">{{item.bindingCount || 0}}</text></view>
          <view class="desk-row"><text class="desk-label">带货者微信</text><text class="desk-value">{{item.carrierWechat || "-"}}</text></view>
        </view>

        <view class="desk-private">
          <view class="desk-private-head"><ap-icon name="lock" size="{{22}}" stroke="{{2.2}}" color="ink-3" /><text>仅后台可见</text></view>
          <view class="desk-private-item">
            <view class="desk-label">带货者收货地址</view>
            <view class="desk-private-value">{{item.carrierReceiveAddress || "-"}}</view>
          </view>
        </view>

        <view class="desk-actions-inner wrap">
          <view wx:for="{{bagStatuses}}" wx:for-item="statusOption" wx:key="value" class="desk-status {{item.status === statusOption.value ? 'active' : ''}}" data-id="{{item._id}}" data-status="{{statusOption.value}}" bindtap="updateBagStatus">{{statusOption.label}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state compact">当前筛选下没有行李额。</view>

    <view class="rl-sec"><text class="rl-sec-no">3</text><text>最近操作</text><text class="desk-count num">{{auditLogs.length}}</text></view>
    <view wx:if="{{auditLogs.length}}" class="rl-group">
      <view wx:for="{{auditLogs}}" wx:key="_id" class="audit-row">
        <view class="audit-top">
          <view class="audit-target">{{item.targetLabel}} · {{item.targetBagNo || item.targetId}}</view>
          <view class="audit-time num">{{item.timeText}}</view>
        </view>
        <view class="audit-status">{{item.statusText}}</view>
        <view class="audit-actor">{{item.actorOpenid}}</view>
      </view>
    </view>
    <view wx:else class="empty-state compact">暂无后台操作日志。</view>
  </view>
</view>
<ap-toast id="ap-toast" />
