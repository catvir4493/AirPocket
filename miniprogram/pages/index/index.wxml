<view class="page landing-page">
  <view class="home-top fade-up" bindlongpress="requestAdminAccess">
    <image class="home-logo logo-light" src="/images/300分辨率/logo.png" mode="aspectFit" />
    <image class="home-logo logo-dark" src="/images/300分辨率/黄色logo.png" mode="aspectFit" />
  </view>

  <view class="home-hero fade-up delay-1">
    <view class="home-greet"><view>把空着的行李额</view><view>变成别人的顺路</view></view>
    <view class="home-art"><ap-art name="route" width="{{250}}" height="{{150}}" /></view>
  </view>
  <view class="home-sub fade-up delay-1">行李空间共享平台 · Luggage Sharing Space</view>

  <view class="entry entry-dark entry-enter" hover-class="entry-press" hover-start-time="20" hover-stay-time="90" bindtap="goFindBags">
    <view class="entry-watermark">FIND</view>
    <view class="eyebrow entry-eyebrow">我要寄东西</view>
    <view class="entry-title">Find Bags</view>
    <view class="entry-desc">
      <block wx:if="{{summaryReady}}">
        <text class="num entry-count">{{availableCount}}</text><text> 个可用行李额</text><text wx:if="{{nearestDate}}"> · 最近 </text><text wx:if="{{nearestDate}}" class="num">{{nearestDate}}</text><text wx:if="{{nearestDate}}"> 出发</text>
      </block>
      <text wx:else>正在查看可用行李额…</text>
    </view>
    <view class="entry-go"><ap-icon name="arrow" size="{{30}}" stroke="{{2.4}}" color="#1c1c1a" /></view>
  </view>

  <view wx:if="{{upcoming.length}}" class="soon fade-up delay-2">
    <view class="soon-head">
      <text>最近出发</text>
      <text class="soon-more" bindtap="goFindBags">全部</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="soon-scroll">
      <view class="soon-track">
        <view wx:for="{{upcoming}}" wx:key="id" class="soon-ticket list-enter {{liftId === item.id ? 'lifting' : ''}}" style="animation-delay: {{260 + index * 60}}ms" hover-class="soon-press" hover-start-time="20" hover-stay-time="90" data-id="{{item.id}}" bindtap="openUpcoming">
          <view class="soon-date"><text class="num">{{item.date}}</text><text class="soon-week">{{item.weekday}}</text></view>
          <view class="soon-route">
            <text class="soon-city">{{item.from}}</text>
            <view class="soon-plane"><ap-icon name="plane" size="{{22}}" color="ink-3" /></view>
            <text class="soon-city">{{item.to}}</text>
          </view>
          <view class="soon-weight"><text class="num">{{item.weight}}</text><text class="soon-unit">kg</text></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="entry entry-light entry-enter delay" hover-class="entry-press" hover-start-time="20" hover-stay-time="90" bindtap="goOfferSpace">
    <view class="entry-watermark">OFFER</view>
    <view class="eyebrow entry-eyebrow">我有空余行李额</view>
    <view class="entry-title">Offer Space</view>
    <view class="entry-desc">发布航班和可用重量，顺路帮人带东西</view>
    <view class="entry-go"><ap-icon name="arrow" size="{{30}}" stroke="{{2.4}}" /></view>
  </view>

  <view class="icon-list home-links fade-up delay-3">
    <view class="icon-row" hover-class="icon-row-press" hover-start-time="20" hover-stay-time="90" bindtap="goProhibitedItems">
      <view class="icon-box"><ap-icon name="shield" size="{{32}}" color="ink-2" /></view>
      <view class="icon-row-copy">
        <view class="icon-row-title">物品合规</view>
        <view class="icon-row-desc">可寄与禁运物品、责任声明</view>
      </view>
      <ap-icon name="chevron" size="{{28}}" color="faint" stroke="{{2}}" />
    </view>
    <view class="icon-row" hover-class="icon-row-press" hover-start-time="20" hover-stay-time="90" bindtap="showCustomerService">
      <view class="icon-box"><ap-icon name="chat" size="{{32}}" color="ink-2" /></view>
      <view class="icon-row-copy">
        <view class="icon-row-title">联系客服</view>
        <view class="icon-row-desc">有疑问随时找我们</view>
      </view>
      <ap-icon name="chevron" size="{{28}}" color="faint" stroke="{{2}}" />
    </view>
    <view class="icon-row" hover-class="icon-row-press" hover-start-time="20" hover-stay-time="90" bindtap="showBusinessCooperation">
      <view class="icon-box"><ap-icon name="briefcase" size="{{32}}" color="ink-2" /></view>
      <view class="icon-row-copy">
        <view class="icon-row-title">商务合作</view>
        <view class="icon-row-desc">渠道、代购与企业合作</view>
      </view>
      <ap-icon name="chevron" size="{{28}}" color="faint" stroke="{{2}}" />
    </view>
    <view wx:if="{{isAdmin}}" class="icon-row" hover-class="icon-row-press" hover-start-time="20" hover-stay-time="90" bindtap="goAdmin">
      <view class="icon-box"><ap-icon name="grid" size="{{32}}" color="ink-2" /></view>
      <view class="icon-row-copy">
        <view class="icon-row-title">后台运营</view>
        <view class="icon-row-desc">Admin Desk</view>
      </view>
      <ap-icon name="chevron" size="{{28}}" color="faint" stroke="{{2}}" />
    </view>
  </view>

  <ap-tabbar preset="landing" current="{{0}}" />
</view>
<ap-toast id="ap-toast" />
