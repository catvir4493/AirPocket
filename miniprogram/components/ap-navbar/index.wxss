.ap-navbar {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 25;
  box-sizing: border-box;
  background: var(--paper);
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0);
  transition: box-shadow 240ms ease;
}

.ap-navbar.collapsed {
  box-shadow: 0 1rpx 0 var(--line);
}

.ap-navbar-bar {
  position: relative;
  display: flex;
  align-items: center;
}

.ap-navbar-back {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 100%;
  transition: opacity 160ms ease;
}

.ap-navbar-back-press {
  opacity: 0.5;
}

.ap-navbar-chevron {
  width: 20rpx;
  height: 20rpx;
  margin-left: 10rpx;
  border-bottom: 4rpx solid var(--ink);
  border-left: 4rpx solid var(--ink);
  transform: rotate(45deg);
}

.ap-navbar-home {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  margin-left: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  background: var(--card);
}

.ap-navbar-title {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.ap-navbar-title-text {
  overflow: hidden;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
  opacity: 0;
  transform: translateY(12rpx);
  transition: opacity 240ms ease, transform 280ms var(--ease-out, cubic-bezier(0.2, 0.8, 0.2, 1));
}

.collapsed .ap-navbar-title-text {
  opacity: 1;
  transform: translateY(0);
}

.ap-navbar-flight {
  position: absolute;
  right: 0;
  bottom: -30rpx;
  left: 0;
  height: 30rpx;
  overflow: hidden;
  pointer-events: none;
  animation: ap-navbar-flight-in 200ms ease backwards;
}

.ap-navbar-flight-dash {
  position: absolute;
  top: 50%;
  right: 32rpx;
  left: 32rpx;
  border-top: 2rpx dashed var(--line-strong);
}

.ap-navbar-flight-plane {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  animation: ap-navbar-fly 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite;
}

@keyframes ap-navbar-fly {
  from {
    transform: translateX(-40rpx) rotate(90deg);
  }
  to {
    transform: translateX(790rpx) rotate(90deg);
  }
}

@keyframes ap-navbar-flight-in {
  from {
    opacity: 0;
  }
}
