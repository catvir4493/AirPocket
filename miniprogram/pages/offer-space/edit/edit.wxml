<import src="../release/bag-form.wxml" />

<ap-navbar title="编辑行李额" collapsed="{{navCollapsed}}" loading="{{refreshing}}" />
<view class="page no-bottom-nav edit-page has-sticky-action">
  <view class="large-title">
    <view class="large-title-inner {{navCollapsed ? 'shrunk' : ''}}">
      <view class="eyebrow page-eyebrow fade-up">Edit</view>
      <view class="page-title fade-up">编辑行李额</view>
    </view>
  </view>
  <view class="page-subtitle fade-up delay-1">只有还没被绑定过的行李额可以修改。</view>

  <view wx:if="{{loading}}" class="edit-skeleton">
    <view class="edit-skeleton-card skeleton-shine"></view>
    <view class="edit-skeleton-card short skeleton-shine"></view>
  </view>

  <view wx:else class="form fade-up delay-2">
    <template is="bag-form" data="{{form, focusedField, minDate, dateText, caseWeightText, quickWeights, specialItemOptions, allowedTags, restrictedTags, tagDraft, preview, roll, errorField, errorTick, pulse, swapKey}}" />
  </view>

  <view wx:if="{{!loading}}" class="sticky-action action-bar">
    <view class="action-summary">
      <view class="action-route">{{summary.route}}</view>
      <view class="action-detail {{summary.ready ? 'ready' : ''}}">{{summary.detail}}</view>
    </view>
    <button class="primary-button action-button {{saved ? 'success' : ''}} {{summary.ready || saved ? '' : 'dim'}}" disabled="{{submitting || saved}}" bindtap="submitBag">
      <view wx:if="{{submitting}}" class="btn-flight">
        <view class="btn-flight-dash"></view>
        <view class="btn-flight-plane"><ap-icon name="plane" size="{{30}}" color="ink-3" /></view>
      </view>
      <block wx:else>{{saved ? '✓ 已保存' : '保存'}}</block>
    </button>
  </view>
</view>
<ap-stamp show="{{saved ? true : false}}" text="已保存" />
<ap-toast id="ap-toast" custom-nav />
