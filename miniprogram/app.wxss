page {
  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --dur-fast: 160ms;
  --dur-base: 260ms;
  --dur-slow: 380ms;
  min-height: 100vh;
  background: #ffffff;
  color: #1f1f1f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

button {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: inherit;
  text-align: center;
}

button::after {
  border: none;
}

button {
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}

.button-hover {
  opacity: 0.82;
  transform: scale(0.97);
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(152rpx + env(safe-area-inset-bottom));
}

.page.no-bottom-nav {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.page-title,
.detail-page-title {
  margin: 8rpx 0 28rpx;
  color: #2c2c2c;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.page-subtitle {
  margin: -14rpx auto 28rpx;
  max-width: 620rpx;
  color: #8d8d8d;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.section-title {
  margin: 28rpx 0 18rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 800;
}

.visual-divider {
  height: 1rpx;
  margin: 28rpx -28rpx;
  background: #eeeeee;
}

.card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #f1f1f1;
}

.card-title {
  color: #242424;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.muted {
  color: #8b8b8b;
  font-size: 24rpx;
  line-height: 1.5;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx -8rpx 0;
}

.meta-item {
  box-sizing: border-box;
  min-width: 0;
  width: 50%;
  padding: 12rpx 8rpx 0;
}

.meta-label {
  color: #858585;
  font-size: 21rpx;
}

.meta-value {
  margin-top: 6rpx;
  color: #333333;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-word;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff51f;
  color: #242424;
  font-size: 21rpx;
  font-weight: 800;
}

.pill.gray {
  background: #ececec;
  color: #777777;
}

.form {
  margin-top: 22rpx;
}

.field {
  position: relative;
  margin-bottom: 22rpx;
  padding-left: 34rpx;
}

.field::before {
  content: "";
  position: absolute;
  top: 18rpx;
  left: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #222222;
}

.field-label {
  margin-bottom: 10rpx;
  color: #6f6f6f;
  font-size: 24rpx;
  font-weight: 600;
}

.field-hint {
  margin-top: 10rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1.45;
}

.input,
.textarea,
.picker-value,
.fixed-value {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  padding: 18rpx 22rpx;
  border: 0;
  border-radius: 0;
  background: #efefef;
  color: #333333;
  font-size: 26rpx;
  line-height: 1.4;
}

.textarea {
  min-height: 142rpx;
}

.placeholder {
  color: #a8a8a8;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-button {
  background: #2f2f2f;
  color: #ffffff;
}

.primary-button[disabled] {
  background: #8e8e8e;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #2f2f2f;
  background: #ffffff;
  color: #2f2f2f;
}

.secondary-button[disabled] {
  border-color: #dddddd;
  background: #f2f2f2;
  color: #9a9a9a;
}

.empty-state {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 38rpx 28rpx;
  border-radius: 8rpx;
  background: #f1f1f1;
  color: #777777;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.choice-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.choice-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dddddd;
  border-radius: 999rpx;
  background: #ffffff;
  color: #555555;
  font-size: 23rpx;
  font-weight: 600;
}

.choice-pill.active {
  border-color: #fff51f;
  background: #fff51f;
  color: #242424;
}

.route-line {
  margin-top: 14rpx;
  color: #333333;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ap-logo {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.ap-logo-mark {
  position: relative;
  width: 138rpx;
  height: 78rpx;
}

.ap-logo-circle {
  position: absolute;
  top: 4rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.ap-logo-circle.orange {
  left: 16rpx;
  background: #ffae16;
}

.ap-logo-circle.blue {
  right: 16rpx;
  background: #69afe8;
}

.ap-logo-name {
  margin-top: 16rpx;
  color: #3a3a3a;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
}

.ap-logo-subtitle {
  margin-top: 8rpx;
  color: #555555;
  font-size: 23rpx;
  line-height: 1.25;
  text-align: center;
}

.ap-logo-cn {
  margin-top: 4rpx;
  color: #9b9b9b;
  font-size: 21rpx;
  line-height: 1.25;
  text-align: center;
}

/* ---------- Motion ---------- */

.fade-up {
  animation: ap-fade-up var(--dur-slow) var(--ease-out) backwards;
}

.fade-up.delay-1 {
  animation-delay: 60ms;
}

.fade-up.delay-2 {
  animation-delay: 120ms;
}

.fade-up.delay-3 {
  animation-delay: 180ms;
}

/* Plays once when a list item is created; kept nodes (same wx:key) do not replay. */
.list-enter {
  animation: ap-list-enter var(--dur-slow) var(--ease-out) backwards;
}

.row-press {
  background: rgba(0, 0, 0, 0.05);
}

.skeleton-shine {
  position: relative;
  overflow: hidden;
}

.skeleton-shine::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(100deg, rgba(255, 255, 255, 0) 30%, rgba(255, 255, 255, 0.7) 50%, rgba(255, 255, 255, 0) 70%);
  transform: translateX(-100%);
  animation: ap-shine 1.2s ease-in-out infinite;
}

.sheet-grab {
  width: 68rpx;
  height: 8rpx;
  margin: -10rpx auto 20rpx;
  border-radius: 8rpx;
  background: #dddddd;
}

.sheet-mask-anim {
  animation: ap-mask-in var(--dur-base) linear both;
}

.sheet-panel-anim {
  animation: ap-sheet-in var(--dur-slow) var(--ease-out) both;
}

.closing .sheet-mask-anim {
  animation: ap-mask-out 220ms linear both;
}

.closing .sheet-panel-anim {
  animation: ap-sheet-out 240ms var(--ease-in) both;
}

@keyframes ap-fade-up {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ap-list-enter {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ap-shine {
  to {
    transform: translateX(100%);
  }
}

@keyframes ap-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes ap-mask-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes ap-sheet-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes ap-sheet-out {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}
