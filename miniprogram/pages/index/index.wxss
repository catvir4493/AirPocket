.landing-page {
  padding-top: 12rpx;
}

.home-top {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-bottom: 36rpx;
}

.home-logo {
  width: 250rpx;
  height: 58rpx;
}

.logo-dark {
  display: none;
}

@media (prefers-color-scheme: dark) {
  .logo-light {
    display: none;
  }

  .logo-dark {
    display: block;
  }
}

.home-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.home-art {
  flex: 0 0 auto;
  margin: 0 -12rpx -6rpx 0;
}

.home-greet {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.home-sub {
  margin: 14rpx 0 36rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}

.entry {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 32rpx 32rpx 34rpx;
  border-radius: 40rpx;
  transition: transform 240ms var(--ease-spring);
}

.entry-enter {
  animation: ap-fade-up var(--dur-slow) var(--ease-out) 160ms backwards;
}

.entry-enter.delay {
  animation-delay: 230ms;
}

.entry-press {
  transform: scale(0.98);
  transition-duration: var(--dur-press);
  transition-timing-function: var(--ease-out);
}

.entry-dark {
  border: 1rpx solid var(--solid-line);
  background: var(--solid);
  color: #ffffff;
}

.entry-light {
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
  box-shadow: var(--shadow);
}

.entry-watermark {
  position: absolute;
  top: 14rpx;
  right: 26rpx;
  font-family: var(--font-num);
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.02em;
  opacity: 0.08;
}

.entry-eyebrow {
  color: inherit;
  letter-spacing: 0.1em;
  opacity: 0.55;
}

.entry-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.entry-desc {
  margin-top: 10rpx;
  padding-right: 90rpx;
  font-size: 23rpx;
  line-height: 1.5;
  opacity: 0.7;
}

.entry-count {
  margin-right: 2rpx;
  color: var(--yellow);
  font-size: 30rpx;
  font-weight: 700;
}

.entry-go {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--yellow);
  transition: transform var(--dur-fast) var(--ease-spring);
}

.entry-light .entry-go {
  background: var(--fill);
}

.entry-press .entry-go {
  transform: translateX(6rpx);
}

.home-links {
  margin-top: 28rpx;
}
