.landing-page {
  padding-top: 12rpx;
}

.home-top {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-bottom: 36rpx;
}

.home-logo {
  width: 250rpx;
  height: 58rpx;
}

.logo-dark {
  display: none;
}

@media (prefers-color-scheme: dark) {
  .logo-light {
    display: none;
  }

  .logo-dark {
    display: block;
  }
}

.home-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.home-art {
  flex: 0 0 auto;
  margin: 0 -12rpx -6rpx 0;
}

.home-greet {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.home-sub {
  margin: 14rpx 0 36rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}

.entry {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 32rpx 32rpx 34rpx;
  border-radius: 40rpx;
  transition: transform 240ms var(--ease-spring);
}

.entry-enter {
  animation: ap-fade-up var(--dur-slow) var(--ease-out) 160ms backwards;
}

.entry-enter.delay {
  animation-delay: 230ms;
}

.entry-press {
  transform: scale(0.98);
  transition-duration: var(--dur-press);
  transition-timing-function: var(--ease-out);
}

.entry-dark {
  border: 1rpx solid var(--solid-line);
  background: var(--solid);
  color: #ffffff;
}

.entry-light {
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
  box-shadow: var(--shadow);
}

.entry-watermark {
  position: absolute;
  top: 14rpx;
  right: 26rpx;
  font-family: var(--font-num);
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.02em;
  opacity: 0.08;
}

.entry-eyebrow {
  color: inherit;
  letter-spacing: 0.1em;
  opacity: 0.55;
}

.entry-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.entry-desc {
  margin-top: 10rpx;
  padding-right: 90rpx;
  font-size: 23rpx;
  line-height: 1.5;
  opacity: 0.7;
}

.entry-count {
  margin-right: 2rpx;
  color: var(--yellow);
  font-size: 30rpx;
  font-weight: 700;
}

.entry-go {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--yellow);
  transition: transform var(--dur-fast) var(--ease-spring);
}

.entry-light .entry-go {
  background: var(--fill);
}

.entry-press .entry-go {
  transform: translateX(6rpx);
}

.home-links {
  margin-top: 28rpx;
}

/* ---------- Upcoming departures strip ---------- */

.soon {
  margin: -4rpx 0 24rpx;
}

.soon-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 14rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.soon-more {
  color: var(--ink-3);
  font-size: 23rpx;
  font-weight: 600;
}

/* Bleeds to the screen edges so tickets scroll out from under the page margin. */
.soon-scroll {
  width: auto;
  margin: 0 -32rpx;
  white-space: nowrap;
}

.soon-track {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 32rpx 20rpx;
}

.soon-ticket {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
  width: 300rpx;
  padding: 22rpx 24rpx 20rpx 32rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--card);
  box-shadow: 0 20rpx 36rpx -30rpx rgba(28, 28, 26, 0.5);
  transition: transform 240ms var(--ease-spring);
}

/* Yellow stub edge, like the boarding-pass cards. */
.soon-ticket::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 10rpx;
  background: var(--yellow);
}

.soon-press {
  transform: scale(0.97);
  transition-duration: var(--dur-press);
}

.soon-ticket.lifting {
  transform: translateY(-6rpx) scale(1.02);
  transition: transform 110ms var(--ease-out);
}

.soon-date {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.soon-date .num {
  color: var(--ink);
  font-family: var(--font-num);
}

.soon-week {
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 600;
}

.soon-route {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
}

.soon-city {
  overflow: hidden;
  max-width: 100rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.soon-plane {
  display: flex;
  transform: rotate(90deg);
}

.soon-weight {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
}

.soon-weight .num {
  color: var(--ink);
  font-family: var(--font-num);
}

.soon-unit {
  margin-left: 4rpx;
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 600;
}
