@import "../detail/detail.wxss";

.lock-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-m);
  background: var(--fill);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.45;
}

.lock-banner.editable {
  background: var(--yellow-soft);
  color: var(--ink);
}
