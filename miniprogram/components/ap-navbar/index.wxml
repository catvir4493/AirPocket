<view class="ap-navbar-placeholder" style="height: {{navTotal}}px;"></view>
<view class="ap-navbar {{collapsed ? 'collapsed' : ''}}" style="height: {{navTotal}}px; padding-top: {{statusBarHeight}}px;">
  <view class="ap-navbar-bar" style="height: {{navHeight}}px;">
    <view class="ap-navbar-back" hover-class="ap-navbar-back-press" hover-stay-time="90" bindtap="onBack">
      <view wx:if="{{canGoBack || interceptBack}}" class="ap-navbar-chevron"></view>
      <view wx:else class="ap-navbar-home"><ap-icon name="home" size="{{32}}" stroke="{{2}}" /></view>
    </view>
    <view class="ap-navbar-title" style="left: {{sideSpace}}px; right: {{sideSpace}}px;">
      <text class="ap-navbar-title-text">{{title}}</text>
    </view>
  </view>
  <!-- Refresh indicator: a small plane flying along a dashed route under the bar. -->
  <view wx:if="{{loading}}" class="ap-navbar-flight">
    <view class="ap-navbar-flight-dash"></view>
    <view class="ap-navbar-flight-plane"><ap-icon name="plane" size="{{30}}" color="ink" /></view>
  </view>
</view>
