@import "../../find-bags/detail/detail.wxss";

.cap-card {
  margin-top: 28rpx;
  padding: 26rpx 28rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.cap-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.binding-section {
  margin-top: 12rpx;
}

.binding-item {
  margin-bottom: 16rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.binding-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.binding-title {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  color: var(--ink);
}

.binding-title .num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.binding-unit {
  color: var(--ink-3);
  font-size: 21rpx;
}

.binding-copy {
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 25rpx;
  line-height: 1.5;
}

.binding-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.5;
}

.binding-time {
  margin-left: auto;
}

.tight-empty {
  margin-top: 0;
}
