.ap-navbar {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 25;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0);
  transition: box-shadow 240ms ease;
}

.ap-navbar.collapsed {
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.08);
}

.ap-navbar-bar {
  position: relative;
  display: flex;
  align-items: center;
}

.ap-navbar-back {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 100%;
  transition: opacity 160ms ease;
}

.ap-navbar-back-press {
  opacity: 0.5;
}

.ap-navbar-chevron {
  width: 20rpx;
  height: 20rpx;
  margin-left: 10rpx;
  border-bottom: 4rpx solid #242424;
  border-left: 4rpx solid #242424;
  transform: rotate(45deg);
}

.ap-navbar-home {
  margin-left: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f2f2f2;
  color: #333333;
  font-size: 22rpx;
  font-weight: 600;
}

.ap-navbar-title {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.ap-navbar-title-text {
  overflow: hidden;
  color: #242424;
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
  opacity: 0;
  transform: translateY(12rpx);
  transition: opacity 240ms ease, transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.collapsed .ap-navbar-title-text {
  opacity: 1;
  transform: translateY(0);
}

.ap-navbar-spinner {
  flex: 0 0 auto;
  width: 26rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border: 4rpx solid #e6e6e6;
  border-top-color: #2f2f2f;
  border-radius: 50%;
  animation: ap-navbar-spin 0.7s linear infinite;
}

@keyframes ap-navbar-spin {
  to {
    transform: rotate(360deg);
  }
}
