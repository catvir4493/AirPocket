@import "../../../styles/grouped-form.wxss";

/* ---------- 1 Trip ticket ---------- */

.trip-ticket {
  position: relative;
  border: 1rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.trip-top {
  display: flex;
  align-items: flex-end;
  padding: 30rpx 32rpx 26rpx;
}

.trip-city {
  flex: 1;
  min-width: 0;
}

.trip-city.right {
  text-align: right;
}

.trip-key {
  color: var(--ink-3);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.trip-input {
  height: 60rpx;
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 60rpx;
  border-bottom: 4rpx solid transparent;
  transition: border-color var(--dur-fast) ease;
}

.trip-input.right {
  text-align: right;
}

.trip-city.focused .trip-input {
  border-bottom-color: var(--yellow);
}

.trip-ph {
  color: var(--placeholder);
  font-weight: 500;
}

.trip-swap {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin: 0 16rpx;
  border-radius: 50%;
  background: var(--fill);
  transition: transform var(--dur-base) var(--ease-spring);
}

.trip-swap-hover {
  transform: rotate(180deg) scale(0.92);
}

/* Perforation with two punched notches. */
.trip-perf {
  position: relative;
  margin: 0 32rpx;
  border-top: 3rpx dashed var(--line-strong);
}

.trip-perf::before,
.trip-perf::after {
  content: "";
  position: absolute;
  top: -18rpx;
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  background: var(--paper);
}

.trip-perf::before {
  left: -50rpx;
}

.trip-perf::after {
  right: -50rpx;
}

.trip-bottom {
  display: flex;
}

.trip-cell {
  flex: 1;
  min-width: 0;
  padding: 22rpx 32rpx 26rpx;
}

.trip-cell + .trip-cell {
  border-left: 1rpx solid var(--line);
}

.trip-value,
.trip-value-input {
  height: 48rpx;
  margin-top: 8rpx;
  color: var(--ink);
  font-family: var(--font-num);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.trip-value.trip-ph,
.trip-value-input .trip-ph {
  color: var(--placeholder);
  font-family: inherit;
  font-weight: 500;
  font-size: 28rpx;
}

/* ---------- 2 Space ---------- */

.space-seg {
  display: flex;
  padding: 8rpx;
  border-radius: 28rpx;
  background: var(--fill);
}

.space-seg-item {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 22rpx;
  text-align: center;
  transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
}

.space-seg-title {
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 600;
}

.space-seg-copy {
  margin-top: 2rpx;
  color: var(--ink-3);
  font-size: 20rpx;
}

.space-seg-item.active {
  background: var(--inverse);
  animation: ap-pop 320ms var(--ease-spring);
}

.space-seg-item.active .space-seg-title {
  color: var(--on-inverse);
}

.space-seg-item.active .space-seg-copy {
  color: var(--on-inverse);
  opacity: 0.6;
}

.tag-box {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.tag-chip {
  display: flex;
  align-items: center;
  padding: 0 14rpx 0 20rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--ink);
  font-size: 23rpx;
  line-height: 44rpx;
  animation: ap-scale-in 260ms var(--ease-spring) backwards;
}

.tag-chip.no {
  background: rgba(179, 38, 30, 0.1);
  color: var(--red);
}

.tag-x {
  margin-left: 6rpx;
  opacity: 0.5;
  font-size: 24rpx;
}

.tag-input {
  flex: 1;
  min-width: 160rpx;
  height: 44rpx;
  color: var(--ink);
  font-size: 25rpx;
  line-height: 44rpx;
}

/* ---------- Preview ---------- */

.preview-title {
  margin: 44rpx 4rpx 16rpx;
}

.preview-card {
  margin-bottom: 0;
}
