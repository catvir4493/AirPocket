.ap-tabbar {
  position: fixed;
  right: 44rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 44rpx;
  z-index: 20;
  display: flex;
  align-items: stretch;
  box-sizing: border-box;
  height: 88rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #2f2f2f;
  box-shadow: 0 14rpx 24rpx rgba(0, 0, 0, 0.2);
}

.ap-tabbar-indicator {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  border-radius: 999rpx;
  background: #fff51f;
  transition: transform 380ms var(--ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));
}

.ap-tabbar-item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  border-radius: 999rpx;
  color: #cfcfcf;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  transition: color 220ms ease, transform 160ms var(--ease-out, cubic-bezier(0.2, 0.8, 0.2, 1));
}

.ap-tabbar-item.active {
  color: #242424;
  font-weight: 600;
}

.ap-tabbar-item-press {
  transform: scale(0.94);
}
