.offer-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 32rpx;
  border-radius: 40rpx;
  background: var(--ink);
  color: #ffffff;
}

.offer-hero-watermark {
  position: absolute;
  top: 14rpx;
  right: 26rpx;
  font-family: var(--font-num);
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.02em;
  opacity: 0.08;
}

.offer-hero-eyebrow {
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.1em;
}

.offer-hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.offer-hero-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 23rpx;
  line-height: 1.6;
}

.offer-hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 0 30rpx;
  min-height: 76rpx;
  border-radius: 999rpx;
  background: var(--yellow);
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.offer-links {
  margin-top: 24rpx;
}
