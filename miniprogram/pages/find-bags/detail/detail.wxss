.detail-code {
  position: relative;
  animation: ap-fade-up var(--dur-slow) var(--ease-out) backwards;
  margin: 54rpx 0 34rpx;
  padding-left: 44rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}

.detail-code::before {
  content: "";
  position: absolute;
  top: 14rpx;
  left: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #222222;
}

.detail-sheet {
  margin-top: 18rpx;
}

.detail-row {
  position: relative;
  animation: ap-fade-up var(--dur-slow) var(--ease-out) backwards;
  animation-delay: 420ms;
  display: flex;
  align-items: center;
  min-height: 58rpx;
  margin-bottom: 18rpx;
  padding-left: 44rpx;
}

.detail-row::before {
  content: "";
  position: absolute;
  top: 23rpx;
  left: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #222222;
}

.detail-row:nth-child(1) { animation-delay: 60ms; }
.detail-row:nth-child(2) { animation-delay: 100ms; }
.detail-row:nth-child(3) { animation-delay: 140ms; }
.detail-row:nth-child(4) { animation-delay: 180ms; }
.detail-row:nth-child(5) { animation-delay: 220ms; }
.detail-row:nth-child(6) { animation-delay: 260ms; }
.detail-row:nth-child(7) { animation-delay: 300ms; }
.detail-row:nth-child(8) { animation-delay: 340ms; }
.detail-row:nth-child(9) { animation-delay: 380ms; }

.detail-label {
  flex: 0 0 162rpx;
  color: #787878;
  font-size: 24rpx;
  line-height: 1.35;
}

.detail-value {
  flex: 1;
  min-width: 0;
  min-height: 38rpx;
  padding: 8rpx 18rpx;
  background: #efefef;
  color: #666666;
  font-size: 24rpx;
  line-height: 1.35;
  word-break: break-word;
}

.detail-note {
  margin: 20rpx 0 30rpx 44rpx;
  color: #777777;
  font-size: 24rpx;
  line-height: 1.55;
}

.detail-form {
  margin-top: 36rpx;
  animation: ap-fade-up var(--dur-slow) var(--ease-out) 300ms backwards;
}

.detail-skeleton {
  margin-top: 54rpx;
}

.detail-skeleton-code {
  width: 220rpx;
  height: 34rpx;
  margin-bottom: 40rpx;
  border-radius: 12rpx;
  background: #ececec;
}

.detail-skeleton-row {
  height: 54rpx;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
  background: #f1f1f1;
}

.primary-button {
  margin-top: 22rpx;
}
