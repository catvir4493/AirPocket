<view class="page no-bottom-nav detail-page">
  <view wx:if="{{loading}}" class="pass-skeleton">
    <view class="pass-skeleton-card skeleton-shine"></view>
    <view class="pass-skeleton-line skeleton-shine"></view>
    <view class="pass-skeleton-line short skeleton-shine"></view>
  </view>

  <block wx:elif="{{binding}}">
    <ap-pass
      code="{{binding.bagNo}}"
      status-text="{{binding.statusText}}"
      status-tone="{{binding.statusTone}}"
      from-city="{{binding.fromCity}}"
      to-city="{{binding.toCity}}"
      date="{{binding.departureDate}}"
      flight-no="{{binding.flightNo}}"
      metric-label="{{binding.isFullCase ? 'Cases' : 'Booked'}}"
      metric-value="{{binding.isFullCase ? binding.requestedCases : binding.requestedWeight}}"
      metric-unit="{{binding.isFullCase ? '件' : 'kg'}}"
      chips="{{binding.passChips}}"
    />

    <view class="lock-banner {{binding.canEdit ? 'editable' : ''}} fade-up delay-1">
      <ap-icon name="{{binding.canEdit ? 'info' : 'shield'}}" size="{{32}}" />
      <text>{{binding.lockText}}</text>
    </view>

    <view class="detail-section fade-up delay-1">
      <view class="section-title">物品信息<text class="eyebrow">Item</text></view>
      <view class="info-list">
        <view class="info-row">
          <view class="info-label">物品</view>
          <view class="info-value">{{binding.itemDescription || '-'}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">特殊物品</view>
          <view class="info-value">{{binding.requestedSpecialItemsText}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">提交时间</view>
          <view class="info-value num">{{binding.createdAtText || '-'}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">可编辑至</view>
          <view class="info-value num">{{binding.lockDeadlineText || '-'}}</view>
        </view>
        <view wx:if="{{binding.senderNote}}" class="info-note">{{binding.senderNote}}</view>
      </view>
    </view>

    <view class="detail-section fade-up delay-2">
      <view class="section-title">联系与取货<text class="eyebrow">Pickup</text></view>
      <view class="info-list">
        <view class="info-row">
          <view class="info-label">微信号</view>
          <view class="info-value">{{binding.senderWechat || '-'}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">取货地址</view>
          <view class="info-value">{{binding.pickupAddress || '-'}}</view>
        </view>
      </view>
    </view>

    <view class="detail-section fade-up delay-3">
      <view class="section-title">收件信息<text class="eyebrow">Receiver</text></view>
      <view class="info-list">
        <view class="info-row">
          <view class="info-label">收件人</view>
          <view class="info-value">{{binding.receiverName || '-'}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">电话</view>
          <view class="info-value num">{{binding.receiverPhone || '-'}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">快递地址</view>
          <view class="info-value">{{binding.deliveryAddress || '-'}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{binding.canEdit}}" class="detail-actions">
      <button class="primary-button" bindtap="goEditBinding">编辑绑定信息</button>
      <button class="danger-button" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancelBinding">取消绑定</button>
    </view>
  </block>

  <view wx:else class="empty-state">没有找到这条绑定。</view>
</view>
<ap-toast id="ap-toast" />
