.rule-card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 18rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.warning-card {
  position: relative;
  padding-left: 46rpx;
}

.warning-card::before {
  content: "";
  position: absolute;
  top: 34rpx;
  left: 24rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ink);
  box-shadow: 0 0 0 6rpx var(--yellow);
}

.rule-title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.rule-copy {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.55;
}

.statement-copy {
  margin-top: 0;
  color: var(--ink-2);
  text-align: justify;
}

.source-item + .source-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.source-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.source-url {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  line-height: 1.45;
  word-break: break-all;
}

.source-action {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 21rpx;
  font-weight: 700;
}

.primary-button {
  margin-top: 28rpx;
}
