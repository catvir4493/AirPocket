<ap-navbar title="{{titles[activeTab]}}" collapsed="{{navCollapsed}}" loading="{{refreshing}}" />

<view class="page tab-shell">
  <view class="page-title large-title">
    <block wx:for="{{[activeTab]}}" wx:key="*this"><view class="title-swap">{{titles[item]}}</view></block>
  </view>

  <view wx:if="{{visited[1]}}" class="tab-panel {{activeTab === 1 ? '' : 'tab-panel-hidden'}}">
    <find-list-panel id="panel-1" />
  </view>
  <view wx:if="{{visited[2]}}" class="tab-panel {{activeTab === 2 ? '' : 'tab-panel-hidden'}}">
    <sender-bindings-panel id="panel-2" />
  </view>

  <ap-tabbar preset="find" current="{{activeTab}}" inline bind:change="onTabChange" />
</view>
