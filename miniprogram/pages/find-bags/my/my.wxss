.my-hero {
  box-sizing: border-box;
  min-height: 262rpx;
  padding: 36rpx 38rpx 34rpx;
  border-radius: 22rpx;
  background: #303030;
}

.my-hero-logo {
  display: block;
  width: 248rpx;
  height: 56rpx;
}

.my-search {
  box-sizing: border-box;
  min-height: 62rpx;
  margin-top: 28rpx;
  padding: 17rpx 26rpx;
  border-radius: 999rpx;
  background: #f2f2f2;
  color: #b4b4b4;
  font-size: 23rpx;
}

.my-search.active {
  color: #2d2d2d;
  font-weight: 700;
}

.my-stat-row {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.my-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff51f;
}

.my-stat-label {
  color: #757500;
  font-size: 20rpx;
  font-weight: 700;
}

.my-stat-value {
  color: #242424;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
}

.my-stat-value.small {
  font-size: 26rpx;
}

.my-list {
  margin-top: 24rpx;
  min-height: 520rpx;
  padding: 26rpx 24rpx 34rpx;
  border-radius: 14rpx;
  background: #eeeeee;
}

.my-skeleton-head {
  height: 24rpx;
  margin: 0 0 26rpx;
  border-radius: 12rpx;
  background: #e2e2e2;
}

.my-skeleton-row {
  height: 30rpx;
  margin-bottom: 30rpx;
  border-radius: 12rpx;
  background: #e4e4e4;
}

.my-table-head,
.my-table-row {
  display: flex;
  align-items: center;
}

.my-table-head view,
.my-table-row view {
  flex: 1;
  min-width: 0;
}

.my-table-head view:first-child,
.my-table-row view:first-child {
  flex: 0 0 170rpx;
}

.my-table-head view:last-child,
.my-table-row view:last-child {
  flex: 0 0 116rpx;
}

.my-table-head {
  padding: 0 0 18rpx;
  border-bottom: 1rpx solid #bdbdbd;
  color: #777777;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}

.my-table-row {
  min-height: 62rpx;
  transition: background var(--dur-fast) ease;
  color: #777777;
  font-size: 23rpx;
  line-height: 1.35;
  text-align: center;
}

.my-table-row + .my-table-row {
  border-top: 1rpx solid #dddddd;
}

.my-table-route {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.my-search-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
}

.my-search-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.28);
}

.my-search-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 58vh;
  padding: 30rpx 28rpx 46rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
}

.my-search-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.my-search-sheet-title {
  color: #303030;
  font-size: 31rpx;
  font-weight: 800;
}

.my-search-close {
  flex: 1;
  min-width: 72rpx;
  min-height: 40rpx;
  color: #777777;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: right;
}

.my-search-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.my-search-field {
  flex: 1;
  min-width: 0;
}

.my-search-label {
  margin: 0 0 6rpx 4rpx;
  color: #8b8b8b;
  font-size: 20rpx;
  font-weight: 700;
}

.my-search-input,
.my-search-picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 58rpx;
  padding: 14rpx 16rpx;
  border: 0;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #333333;
  font-size: 23rpx;
  line-height: 1.35;
}

.my-search-picker.placeholder {
  color: #b2b2b2;
}

.my-clear-search {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 48rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  color: #777777;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 48rpx;
}
