.admin-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin: 28rpx 0;
}

.summary-item {
  box-sizing: border-box;
  padding: 26rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.summary-item:first-child {
  background: var(--ink);
}

.summary-item:first-child .summary-number {
  color: var(--yellow);
}

.summary-item:first-child .summary-label {
  color: rgba(255, 255, 255, 0.6);
}

.summary-number {
  color: var(--ink);
  font-family: var(--font-num);
  font-variant-numeric: tabular-nums;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
}

.summary-label {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.filter-panel {
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--fill);
}

.admin-search {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: var(--ink);
  font-size: 26rpx;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.filter-picker {
  flex: 1;
}

.filter-value {
  box-sizing: border-box;
  min-height: 68rpx;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: var(--ink);
  font-size: 23rpx;
  line-height: 1.25;
}

.reset-button {
  min-height: 64rpx;
  margin-top: 16rpx;
  border: 1rpx solid var(--ink);
  border-radius: 999rpx;
  background: transparent;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.desk-section {
  margin-top: 34rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.section-count {
  min-width: 52rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: var(--yellow);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.work-card,
.bag-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.pill.status-cancelled,
.pill.status-closed,
.pill.status-expired {
  background: var(--fill);
  color: var(--ink-3);
  text-decoration: line-through;
}

.pill.status-locked,
.pill.status-contacted,
.pill.status-picked_up,
.pill.status-packed,
.pill.status-delivered_to_carrier {
  background: var(--fill);
  color: var(--ink-2);
}

.pill.status-completed,
.pill.status-active {
  background: var(--green-bg);
  color: var(--green);
}

.admin-skeleton-card {
  height: 260rpx;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
  background: var(--fill);
}

.work-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.work-code {
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.25;
}

.work-route {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.35;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.info-label {
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 700;
}

.info-value {
  text-align: left;
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-word;
}

.sensitive-block {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: var(--r-m);
  background: var(--fill);
}

.sensitive-label {
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 700;
}

.sensitive-value {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 25rpx;
  line-height: 1.45;
  word-break: break-word;
}

.admin-actions {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx -6rpx 0;
}

.status-button {
  box-sizing: border-box;
  min-height: 56rpx;
  margin: 8rpx 6rpx 0;
  padding: 0 16rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.status-button {
  transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
}

.status-button.active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--yellow);
  animation: ap-pop 320ms var(--ease-spring);
}

.bag-meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx 16rpx;
  margin-top: 16rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.audit-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.audit-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.audit-target {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.audit-time,
.audit-actor {
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.4;
}

.audit-status {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 700;
}

.compact {
  margin-top: 14rpx;
  padding: 28rpx;
}
