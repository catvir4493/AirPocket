<import src="../detail/bind-form.wxml" />

<view class="page no-bottom-nav edit-binding-page {{binding ? 'has-sticky-action' : ''}}">
  <view class="eyebrow page-eyebrow fade-up">Edit</view>
  <view class="page-title fade-up">编辑绑定</view>
  <view class="page-subtitle fade-up delay-1">锁单前可以修改重量、物品和联系信息，锁单后需要联系客服。</view>

  <view wx:if="{{loading}}" class="edit-skeleton">
    <view class="edit-skeleton-card skeleton-shine"></view>
    <view class="edit-skeleton-card short skeleton-shine"></view>
  </view>

  <block wx:elif="{{binding}}">
    <view class="edit-ticket fade-up delay-1">
      <view class="edit-ticket-top">
        <text class="edit-ticket-code">#{{binding.bagNo}}</text>
        <text class="tag tag-wait">{{binding.spaceTypeText}}</text>
      </view>
      <view class="edit-ticket-route">
        <text class="edit-ticket-city">{{binding.fromCity}}</text>
        <view class="edit-ticket-line"><view class="edit-ticket-dash"></view><view class="edit-ticket-plane"><ap-icon name="plane" size="{{26}}" color="ink" /></view></view>
        <text class="edit-ticket-city right">{{binding.toCity}}</text>
      </view>
      <view class="edit-ticket-meta">
        <view><view class="eyebrow">Departure</view><view class="edit-ticket-value num">{{binding.departureDate}}</view></view>
        <view><view class="eyebrow">Editable until</view><view class="edit-ticket-value num">{{binding.lockDeadlineText}}</view></view>
      </view>
    </view>

    <view class="form detail-form">
      <template is="bind-form" data="{{form, formInfo, focusedField, specialItemOptions, quickWeights, roll, errorField, errorTick}}" />
    </view>

    <view class="sticky-action action-bar">
      <view class="action-summary">
        <view class="action-route">{{summary.route}}</view>
        <view class="action-detail {{summary.ready ? 'ready' : ''}}">{{summary.detail}}</view>
      </view>
      <button class="primary-button action-button {{saved ? 'success' : ''}} {{summary.ready || saved ? '' : 'dim'}}" disabled="{{submitting || saved}}" bindtap="submitBinding">
        <view wx:if="{{submitting}}" class="btn-flight">
          <view class="btn-flight-dash"></view>
          <view class="btn-flight-plane"><ap-icon name="plane" size="{{30}}" color="ink-3" /></view>
        </view>
        <block wx:else>{{saved ? '✓ 已保存' : '保存'}}</block>
      </button>
    </view>
  </block>

  <view wx:else class="empty-state">没有找到这条绑定。</view>
</view>
<ap-stamp show="{{saved ? true : false}}" text="已保存" sub="{{binding ? '#' + binding.bagNo : ''}}" />
<ap-toast id="ap-toast" />
