<view class="page landing-page">
  <view class="home-pattern fade-up">
    <image class="home-pattern-art" src="/images/300分辨率/home首页.png" mode="aspectFit" />
  </view>

  <view class="home-logo-wrap fade-up delay-1" bindlongpress="requestAdminAccess">
    <view class="home-logo-block">
      <image class="home-logo-image" src="/images/300分辨率/logo.png" mode="aspectFit" />
      <view class="home-logo-subtitle">Luggage Sharing Space</view>
      <view class="home-logo-cn">行李空间共享平台</view>
    </view>
  </view>

  <view class="home-menu fade-up delay-2">
    <view class="home-menu-title">Welcome to Airpocket</view>

    <view class="home-menu-item" hover-class="menu-item-press" hover-start-time="20" hover-stay-time="90" bindtap="goFindBags">
      <view class="home-menu-dot"></view>
      <view class="home-menu-copy">
        <view class="home-menu-name">Find Bags</view>
        <view class="home-menu-desc">很多个新袋子</view>
      </view>
    </view>

    <view class="home-menu-item" hover-class="menu-item-press" hover-start-time="20" hover-stay-time="90" bindtap="goOfferSpace">
      <view class="home-menu-dot"></view>
      <view class="home-menu-copy">
        <view class="home-menu-name">Offer Space</view>
        <view class="home-menu-desc">发布空余行李额</view>
      </view>
    </view>

    <view class="home-menu-item" hover-class="menu-item-press" hover-start-time="20" hover-stay-time="90" bindtap="showBusinessCooperation">
      <view class="home-menu-dot"></view>
      <view class="home-menu-copy">
        <view class="home-menu-name">Business cooperation</view>
        <view class="home-menu-desc">商务合作</view>
      </view>
    </view>

    <view class="home-menu-item" hover-class="menu-item-press" hover-start-time="20" hover-stay-time="90" bindtap="showCustomerService">
      <view class="home-menu-dot"></view>
      <view class="home-menu-copy">
        <view class="home-menu-name">Contact Customer Service</view>
        <view class="home-menu-desc">如有疑问联系客服</view>
      </view>
    </view>

    <view class="home-menu-item" hover-class="menu-item-press" hover-start-time="20" hover-stay-time="90" bindtap="goProhibitedItems">
      <view class="home-menu-dot"></view>
      <view class="home-menu-copy">
        <view class="home-menu-name">Item Compliance</view>
        <view class="home-menu-desc">物品合规与责任声明</view>
      </view>
    </view>

    <view wx:if="{{isAdmin}}" class="home-menu-item" hover-class="menu-item-press" hover-start-time="20" hover-stay-time="90" bindtap="goAdmin">
      <view class="home-menu-dot"></view>
      <view class="home-menu-copy">
        <view class="home-menu-name">Admin Panel</view>
        <view class="home-menu-desc">后台运营管理</view>
      </view>
    </view>
  </view>

  <ap-tabbar preset="landing" current="{{0}}" />
</view>
