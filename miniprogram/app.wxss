page {
  /* Motion */
  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  /* Spring: a light overshoot, enough to feel alive without wobbling */
  --ease-spring: cubic-bezier(0.34, 1.32, 0.64, 1);
  --ease-swift: cubic-bezier(0.3, 0, 0.2, 1);
  --dur-press: 90ms;
  --dur-fast: 160ms;
  --dur-base: 260ms;
  --dur-slow: 380ms;

  /* Colour: paper + ink, yellow only as an accent, one warm grey */
  --paper: #fffefa;
  --card: #ffffff;
  --fill: #f4f3ee;
  --line: rgba(28, 28, 26, 0.08);
  --line-strong: rgba(28, 28, 26, 0.16);
  --ink: #1c1c1a;
  --ink-2: #55534c;
  --ink-3: #9a978c;
  --yellow: #fff51f;
  --yellow-soft: #fff9b8;
  --green: #3f6a1d;
  --green-bg: #e8f3df;
  --red: #b3261e;
  --placeholder: #c4c2b9;
  --paper-clear: rgba(255, 254, 250, 0);
  --shine: rgba(255, 255, 255, 0.7);
  /* Dark hero surfaces (entry card, route overview, tab bar) */
  --solid: #1c1c1a;
  --solid-line: rgba(255, 255, 255, 0);
  /* Primary button / selected chip */
  --inverse: #1c1c1a;
  --on-inverse: #ffffff;
  --inverse-accent: #fff51f;

  /* Shape */
  --r-s: 12rpx;
  --r-m: 20rpx;
  --r-l: 28rpx;
  --shadow: 0 24rpx 48rpx -32rpx rgba(28, 28, 26, 0.4);

  /* Type: numbers use a narrow face where the system has one */
  --font-num: "DIN Alternate", "DIN Condensed", "Roboto Condensed", "sans-serif-condensed", "Helvetica Neue", Arial, sans-serif;

  min-height: 100vh;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}


/* Dark mode: same tokens, darker paper. The Available Bags cards keep their own colours. */
@media (prefers-color-scheme: dark) {
  page {
    --paper: #141412;
    --card: #1e1e1b;
    --fill: #2a2a26;
    --line: rgba(255, 255, 255, 0.08);
    --line-strong: rgba(255, 255, 255, 0.16);
    --ink: #f2f1ea;
    --ink-2: #c3c1b6;
    --ink-3: #8a887e;
    --yellow-soft: rgba(255, 245, 31, 0.14);
    --green: #a9d48a;
    --green-bg: rgba(126, 180, 90, 0.18);
    --red: #ff8a80;
    --placeholder: #5f5d55;
    --paper-clear: rgba(20, 20, 18, 0);
    --shine: rgba(255, 255, 255, 0.06);
    --shadow: 0 24rpx 48rpx -32rpx rgba(0, 0, 0, 0.8);
    --solid: #23231f;
    --solid-line: rgba(255, 255, 255, 0.08);
    --inverse: #fff51f;
    --on-inverse: #1c1c1a;
    --inverse-accent: #1c1c1a;
  }
}

button {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: inherit;
  text-align: center;
}

button::after {
  border: none;
}

button {
  transition: transform 240ms var(--ease-spring), opacity var(--dur-fast) var(--ease-out);
}

/* Press states: the hover class sets a short transition for the press,
   the base rule a springy one for the release. */
.button-hover {
  opacity: 0.82;
  transform: scale(0.97);
  transition-duration: var(--dur-press);
  transition-timing-function: var(--ease-out);
}

.num {
  font-family: var(--font-num);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.01em;
}

.eyebrow {
  color: var(--ink-3);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.page.no-bottom-nav {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.page-title,
.detail-page-title {
  margin: 8rpx 0 28rpx;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.01em;
}

.page-eyebrow {
  margin-top: 8rpx;
}

.page-eyebrow + .page-title {
  margin-top: 6rpx;
}

.page-subtitle {
  margin: -14rpx 0 32rpx;
  max-width: 620rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 40rpx 4rpx 16rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.visual-divider {
  height: 1rpx;
  margin: 28rpx -32rpx;
  background: var(--line);
}

.card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.card-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muted {
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx -8rpx 0;
}

.meta-item {
  box-sizing: border-box;
  min-width: 0;
  width: 50%;
  padding: 12rpx 8rpx 0;
}

.meta-label {
  color: var(--ink-3);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.meta-value {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-word;
}

/* ---------- Status tags (one palette for the whole app, admin included) ---------- */

.pill,
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--ink-2);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.pill {
  background: var(--yellow);
  color: #1c1c1a;
}

.pill.gray {
  background: var(--fill);
  color: var(--ink-2);
}

.tag-wait {
  background: var(--yellow);
  color: #1c1c1a;
}

.tag-ok,
.tag-done {
  background: var(--green-bg);
  color: var(--green);
}

.tag-progress {
  background: var(--fill);
  color: var(--ink-2);
}

.tag-off {
  background: var(--fill);
  color: var(--ink-3);
  text-decoration: line-through;
}

.tag-code {
  background: transparent;
  padding: 0;
  color: var(--ink-3);
  font-family: var(--font-num);
  font-size: 22rpx;
  letter-spacing: 0.04em;
}

/* ---------- Form fields: white box, hairline, label inside ---------- */

.form {
  margin-top: 22rpx;
}

.field {
  position: relative;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 18rpx 24rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-m);
  background: var(--card);
  transition: border-color var(--dur-fast) ease, box-shadow var(--dur-base) var(--ease-out);
}

.field.focused {
  border-color: var(--ink);
  box-shadow: 0 0 0 6rpx rgba(255, 245, 31, 0.55);
}

.field-label {
  margin-bottom: 6rpx;
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.4;
}

.field-hint {
  margin-top: 10rpx;
  color: var(--ink-3);
  font-size: 21rpx;
  line-height: 1.5;
}

.input,
.textarea,
.picker-value,
.fixed-value {
  box-sizing: border-box;
  width: 100%;
  min-height: 48rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
}

.input {
  height: 48rpx;
}

.fixed-value {
  color: var(--ink-2);
}

.textarea {
  min-height: 112rpx;
  height: 112rpx;
}

.placeholder {
  color: var(--placeholder);
}

/* ---------- Buttons ---------- */

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  border-radius: var(--r-l);
  font-size: 28rpx;
  font-weight: 600;
}

.primary-button {
  background: var(--inverse);
  color: var(--on-inverse);
}

.primary-button[disabled] {
  background: var(--line-strong);
  color: var(--ink-3);
}

.primary-button .button-num {
  color: var(--inverse-accent);
  font-family: var(--font-num);
  font-size: 32rpx;
  font-weight: 700;
}

.primary-button.success,
.primary-button.success[disabled] {
  background: var(--yellow);
  color: #1c1c1a;
  animation: ap-pop 360ms var(--ease-spring);
}

.secondary-button {
  border: 1rpx solid var(--line-strong);
  background: var(--card);
  color: var(--ink);
}

.secondary-button[disabled] {
  border-color: var(--line);
  background: var(--fill);
  color: var(--ink-3);
}

.danger-button {
  border: 1rpx solid rgba(179, 38, 30, 0.24);
  background: var(--card);
  color: var(--red);
}

.empty-state {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 44rpx 32rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--r-l);
  background: transparent;
  color: var(--ink-3);
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
  animation: ap-fade-in var(--dur-slow) var(--ease-out) backwards;
}

/* Load failed with nothing to show: illustration, a short line and a retry button. */
.error-state {
  border-style: solid;
  border-color: var(--line);
  background: var(--card);
}

.error-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.error-copy {
  margin-top: 6rpx;
}

.error-retry {
  width: auto;
  min-height: 76rpx;
  margin: 28rpx auto 4rpx;
  padding: 0 48rpx;
  font-size: 26rpx;
}

.choice-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 6rpx;
}

.choice-pill {
  display: inline-flex;
  width: auto;
  margin: 0;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  background: var(--card);
  color: var(--ink-2);
  font-size: 23rpx;
  font-weight: 500;
}

.choice-pill {
  transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
}

.choice-pill.active {
  border-color: var(--inverse);
  background: var(--inverse);
  color: var(--on-inverse);
  animation: ap-pop 320ms var(--ease-spring);
}

.route-line {
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

/* ---------- Info list (label left, value right) used under the boarding pass ---------- */

.info-list {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx;
}

.info-row + .info-row {
  border-top: 1rpx solid var(--line);
}

.info-label {
  flex: 0 0 auto;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 25rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-word;
}

.info-note {
  padding: 22rpx 28rpx 26rpx;
  border-top: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- Icon list rows (home, offer space) ---------- */

.icon-list {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.icon-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  transition: background var(--dur-fast) ease;
}

.icon-row + .icon-row {
  border-top: 1rpx solid var(--line);
}

.icon-row-press {
  background: var(--fill);
  transition-duration: 60ms;
}

.icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--fill);
}

.icon-row-copy {
  flex: 1;
  min-width: 0;
}

.icon-row-title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.icon-row-desc {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.4;
}

/* ---------- Large title (pages with the custom navbar) ---------- */

/* Shrinks up and away while the navbar's small title takes over. The observed
   .large-title box itself never moves, so the observer does not flicker. */
.large-title-inner {
  transform-origin: left bottom;
  transition: transform 320ms var(--ease-out), opacity 220ms ease;
}

.large-title-inner.shrunk {
  opacity: 0;
  transform: translateY(-18rpx) scale(0.8);
}

/* Top-of-page marker for detail pages: the navbar's hairline appears once it scrolls under. */
.nav-sentinel {
  height: 2rpx;
  margin-bottom: -2rpx;
}

/* ---------- Shared blocks ---------- */

.empty-art {
  display: flex;
  justify-content: center;
  margin: -8rpx auto 12rpx;
  animation: ap-drop-in 640ms var(--ease-spring) backwards, ap-float 3.6s ease-in-out 640ms infinite;
}

/* Fixed bottom action bar for long forms; the page adds .has-sticky-action. */
.page.has-sticky-action {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.sticky-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 40rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(var(--paper-clear), var(--paper) 40%);
}

.sticky-action .primary-button {
  margin-top: 0;
}

.form-group-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 4rpx 16rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.form-group-title:first-child {
  margin-top: 8rpx;
}

.count-swap {
  display: inline-block;
  animation: ap-fade-up var(--dur-base) var(--ease-out) backwards;
}

/* ---------- Motion ---------- */

.fade-up {
  animation: ap-fade-up var(--dur-slow) var(--ease-out) backwards;
}

.fade-up.delay-1 {
  animation-delay: 60ms;
}

.fade-up.delay-2 {
  animation-delay: 120ms;
}

.fade-up.delay-3 {
  animation-delay: 180ms;
}

/* Plays once when a list item is created; kept nodes (same wx:key) do not replay. */
.list-enter {
  animation: ap-list-enter var(--dur-slow) var(--ease-out) backwards;
}

.content-in {
  animation: ap-fade-in var(--dur-base) var(--ease-out) backwards;
}

/* A form field that failed validation: shake once, label turns red for a moment.
   shake-0 / shake-1 alternate so a second failed submit replays the shake. */
.field-error.shake-0 {
  animation: ap-shake-a 420ms var(--ease-out);
}

.field-error.shake-1 {
  animation: ap-shake-b 420ms var(--ease-out);
}

.field-error .rl-label,
.field-error .trip-key,
.field-error .amount-label {
  color: var(--red);
}

/* Loading state inside a button: a small plane flying along a dashed route. */
.btn-flight {
  position: relative;
  width: 168rpx;
  height: 36rpx;
  overflow: hidden;
}

.btn-flight-dash {
  position: absolute;
  top: 50%;
  right: 8rpx;
  left: 8rpx;
  border-top: 2rpx dashed currentColor;
  opacity: 0.45;
}

.btn-flight-plane {
  position: absolute;
  top: 3rpx;
  left: 0;
  display: flex;
  animation: ap-btn-fly 1s cubic-bezier(0.45, 0, 0.55, 1) infinite;
}

@keyframes ap-btn-fly {
  from {
    transform: translateX(-30rpx) rotate(90deg);
  }
  to {
    transform: translateX(168rpx) rotate(90deg);
  }
}

@keyframes ap-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes ap-drop-in {
  0% {
    opacity: 0;
    transform: translateY(-36rpx) scale(0.92);
  }
  60% {
    opacity: 1;
  }
  100% {
    transform: translateY(0) scale(1);
  }
}

@keyframes ap-shake-a {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-12rpx);
  }
  40% {
    transform: translateX(10rpx);
  }
  60% {
    transform: translateX(-6rpx);
  }
  80% {
    transform: translateX(3rpx);
  }
}

@keyframes ap-shake-b {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-12rpx);
  }
  40% {
    transform: translateX(10rpx);
  }
  60% {
    transform: translateX(-6rpx);
  }
  80% {
    transform: translateX(3rpx);
  }
}

/* Tab panels slide in from the side they come from. */
@keyframes ap-tab-in-fwd {
  from {
    opacity: 0;
    transform: translateX(48rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes ap-tab-in-back {
  from {
    opacity: 0;
    transform: translateX(-48rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes ap-flip-in {
  0% {
    opacity: 0;
    transform: perspective(400rpx) rotateX(-90deg);
  }
  60% {
    opacity: 1;
  }
  100% {
    transform: perspective(400rpx) rotateX(0);
  }
}

.row-press {
  background: var(--line);
}

.skeleton-shine {
  position: relative;
  overflow: hidden;
  animation: ap-fade-in 240ms ease 140ms backwards;
}

.skeleton-shine::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(100deg, rgba(255, 255, 255, 0) 30%, var(--shine) 50%, rgba(255, 255, 255, 0) 70%);
  transform: translateX(-100%);
  animation: ap-shine 1.2s ease-in-out infinite;
}

.sheet-grab {
  width: 68rpx;
  height: 8rpx;
  margin: -10rpx auto 20rpx;
  border-radius: 8rpx;
  background: var(--line-strong);
}

.sheet-mask-anim {
  animation: ap-mask-in var(--dur-base) linear both;
}

.sheet-panel-anim {
  animation: ap-sheet-in var(--dur-slow) var(--ease-out) both;
}

.closing .sheet-mask-anim {
  animation: ap-mask-out 220ms linear both;
}

.closing .sheet-panel-anim {
  animation: ap-sheet-out 240ms var(--ease-in) both;
}

@keyframes ap-fade-up {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ap-list-enter {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ap-pop {
  40% {
    transform: scale(1.08);
  }
}

@keyframes ap-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

@keyframes ap-bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6rpx);
  }
}

@keyframes ap-scale-in {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes ap-slide-in {
  from {
    opacity: 0;
    transform: translateX(-24rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes ap-draw-line {
  from {
    transform: scaleY(0);
  }
  to {
    transform: scaleY(1);
  }
}

@keyframes ap-shine {
  to {
    transform: translateX(100%);
  }
}

@keyframes ap-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes ap-mask-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes ap-sheet-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes ap-sheet-out {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}

/* ---------- Available Bags card (find list and the release preview) ---------- */

/* A boarding-pass stub (yellow date) plus a ticket body. */
.bag-card {
  position: relative;
  display: flex;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--card);
  box-shadow: 0 24rpx 44rpx -36rpx rgba(28, 28, 26, 0.5);
  transition: transform 240ms var(--ease-spring);
}

.bag-card-hover {
  transform: scale(0.98);
  transition: transform var(--dur-press) var(--ease-out);
}

/* Tapped: lifts toward the viewer just before the detail page opens. */
.bag-card.lifting {
  transform: translateY(-8rpx) scale(1.015);
  box-shadow: 0 34rpx 56rpx -30rpx rgba(28, 28, 26, 0.45);
  transition: transform 110ms var(--ease-out), box-shadow 110ms ease;
}

/* New since the last refresh: a yellow ring that fades. */
.bag-card.fresh {
  animation: ap-list-enter var(--dur-slow) var(--ease-out) backwards, ap-fresh 1600ms ease-out 200ms;
}

@keyframes ap-fresh {
  0%,
  30% {
    box-shadow: 0 0 0 6rpx var(--yellow), 0 24rpx 44rpx -36rpx rgba(28, 28, 26, 0.5);
  }
  100% {
    box-shadow: 0 0 0 6rpx rgba(255, 245, 31, 0), 0 24rpx 44rpx -36rpx rgba(28, 28, 26, 0.5);
  }
}

.bag-stub {
  position: relative;
  display: flex;
  flex: 0 0 116rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 31rpx 0 0 31rpx;
  background: var(--yellow);
  color: #1c1c1a;
}

/* Perforation between stub and body. */
.bag-stub::after {
  content: "";
  position: absolute;
  top: 16rpx;
  right: -2rpx;
  bottom: 16rpx;
  border-right: 4rpx dashed var(--card);
}

.bag-stub-day {
  font-family: var(--font-num);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.bag-stub-month {
  margin-top: 6rpx;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.16em;
}

.bag-main {
  flex: 1;
  min-width: 0;
  padding: 26rpx 28rpx 24rpx;
}

.bag-route {
  display: flex;
  align-items: center;
}

.bag-city {
  flex: 0 1 auto;
  max-width: 40%;
  overflow: hidden;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bag-line {
  position: relative;
  flex: 1;
  min-width: 48rpx;
  height: 30rpx;
  margin: 0 14rpx;
}

.bag-line-dash {
  position: absolute;
  top: 50%;
  right: 0;
  left: 0;
  border-top: 2rpx dashed var(--line-strong);
}

.bag-plane {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  padding: 0 6rpx;
  background: var(--card);
  transform: translate(-50%, -50%) rotate(90deg);
}

.bag-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}

.bag-chips {
  display: flex;
  flex: 1;
  min-width: 0;
  gap: 8rpx;
  overflow: hidden;
  white-space: nowrap;
}

.bag-chip {
  flex: 0 0 auto;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--ink-2);
  font-size: 19rpx;
  line-height: 1.4;
}

.bag-weight {
  flex: 0 0 auto;
  color: var(--ink-3);
  font-size: 20rpx;
  white-space: nowrap;
}

.bag-weight-num {
  margin-right: 2rpx;
  color: var(--ink);
  font-family: var(--font-num);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

@media (prefers-color-scheme: dark) {
  .bag-card {
    box-shadow: 0 24rpx 44rpx -32rpx rgba(0, 0, 0, 0.8);
  }
}
