<view class="page no-bottom-nav detail-page">
  <view class="detail-page-title fade-up">Bag Detail</view>

  <view wx:if="{{loading}}" class="detail-skeleton">
    <view class="detail-skeleton-code skeleton-shine"></view>
    <view wx:for="{{[0, 1, 2, 3, 4, 5]}}" wx:key="*this" class="detail-skeleton-row skeleton-shine"></view>
  </view>

  <block wx:elif="{{bag}}">
    <view class="detail-code">#{{bag.bagNo}}</view>

    <view class="detail-sheet">
      <view class="detail-row">
        <view class="detail-label">袋子编号</view>
        <view class="detail-value">{{bag.bagNo}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">日期</view>
        <view class="detail-value">{{bag.departureDate}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">出发地</view>
        <view class="detail-value">{{bag.fromCity}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">目的地</view>
        <view class="detail-value">{{bag.toCity}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">航班号</view>
        <view class="detail-value">{{bag.flightNo || '-'}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">类型</view>
        <view class="detail-value">{{bag.spaceTypeText}}</view>
      </view>
      <view wx:if="{{bag.isFullCase}}" class="detail-row">
        <view class="detail-label">整箱数量</view>
        <view class="detail-value">{{bag.caseCountText}}</view>
      </view>
      <view wx:if="{{bag.isFullCase}}" class="detail-row">
        <view class="detail-label">剩余整箱</view>
        <view class="detail-value">{{bag.remainingCasesText}}</view>
      </view>
      <view wx:else class="detail-row">
        <view class="detail-label">总重量</view>
        <view class="detail-value">{{bag.totalWeightText}}</view>
      </view>
      <view wx:if="{{bag.isLoose}}" class="detail-row">
        <view class="detail-label">剩余重量</view>
        <view class="detail-value">{{bag.remainingWeightText}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">已绑定</view>
        <view class="detail-value">{{bag.boundWeightText}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">绑定数量</view>
        <view class="detail-value">{{bag.bindingCount || 0}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">状态</view>
        <view class="detail-value">{{bag.statusText}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">微信号</view>
        <view class="detail-value">{{bag.carrierWechat || '-'}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">收货地址</view>
        <view class="detail-value">{{bag.carrierReceiveAddress || '-'}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">可用体积</view>
        <view class="detail-value">{{bag.availableVolume || '-'}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">特殊物品</view>
        <view class="detail-value">{{bag.specialItemOptionsText}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">可接受</view>
        <view class="detail-value">{{bag.allowedItemsText}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">不接受</view>
        <view class="detail-value">{{bag.restrictedItemsText}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">发布时间</view>
        <view class="detail-value">{{bag.createdAtText || '-'}}</view>
      </view>
      <view wx:if="{{bag.note}}" class="detail-note">{{bag.note}}</view>
    </view>

    <view class="detail-actions">
      <button wx:if="{{bag.canEdit}}" class="primary-button" bindtap="editBag">Edit Bag / 编辑</button>
      <button wx:else class="secondary-button" disabled>已有绑定，不能编辑</button>
    </view>

    <view class="binding-section">
      <view class="section-title">Bindings</view>
      <view wx:if="{{bag.bindings.length}}">
        <view wx:for="{{bag.bindings}}" wx:key="_id" class="binding-item">
          <view class="binding-top">
            <view class="binding-title">{{item.spaceType === 'fullCase' ? item.requestedCasesText : item.requestedWeightText}}</view>
            <view class="binding-status">{{item.spaceTypeText}} · {{item.statusText}}</view>
          </view>
          <view class="binding-copy">{{item.itemDescription || '-'}}</view>
          <view class="binding-copy">特殊物品：{{item.requestedSpecialItemsText}}</view>
          <view class="binding-copy">{{item.createdAtText || '-'}}</view>
        </view>
      </view>
      <view wx:else class="empty-state tight-empty">暂无绑定记录。</view>
    </view>
  </block>

  <view wx:else class="empty-state">没有找到这条 bag。</view>
</view>
