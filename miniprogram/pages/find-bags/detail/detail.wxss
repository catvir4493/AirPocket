/* Shared by all detail pages: boarding pass on top, info list / form below. */
.detail-page {
  padding-top: 24rpx;
}

.detail-form {
  margin-top: 12rpx;
  animation: ap-fade-up var(--dur-slow) var(--ease-out) 200ms backwards;
}

.detail-section {
  animation: ap-fade-up var(--dur-slow) var(--ease-out) backwards;
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 36rpx;
  animation: ap-fade-up var(--dur-slow) var(--ease-out) 360ms backwards;
}

.pass-skeleton-card {
  height: 400rpx;
  border-radius: 40rpx;
  background: var(--fill);
}

.pass-skeleton-line {
  height: 30rpx;
  margin-top: 44rpx;
  border-radius: 12rpx;
  background: var(--fill);
}

.pass-skeleton-line.short {
  width: 60%;
  margin-top: 24rpx;
}
