<ap-navbar title="{{titles[activeTab]}}" collapsed="{{navCollapsed}}" loading="{{refreshing}}" intercept-back="{{activeTab === 2}}" bind:back="onNavBack" />

<view class="page tab-shell">
  <view class="large-title">
    <block wx:for="{{[activeTab]}}" wx:key="*this">
      <view class="title-swap large-title-inner {{tabDir ? 'tab-in-' + tabDir : ''}} {{navCollapsed ? 'shrunk' : ''}}">
        <view class="eyebrow">{{eyebrows[item]}}</view>
        <view class="page-title">{{titles[item]}}</view>
      </view>
    </block>
  </view>

  <view wx:if="{{visited[1]}}" class="tab-panel {{activeTab === 1 ? 'tab-in-' + tabDir : 'tab-panel-hidden'}}">
    <find-list-panel id="panel-1" />
  </view>
  <view wx:if="{{visited[2]}}" class="tab-panel {{activeTab === 2 ? 'tab-in-' + tabDir : 'tab-panel-hidden'}}">
    <sender-bindings-panel id="panel-2" />
  </view>

  <ap-tabbar preset="find" current="{{activeTab}}" inline bind:change="onTabChange" />
</view>
<ap-toast id="ap-toast" custom-nav />
