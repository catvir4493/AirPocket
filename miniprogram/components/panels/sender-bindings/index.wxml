<view class="my-panel">
  <view class="my-stats fade-up delay-1">
    <view class="my-stat">
      <view class="my-stat-value num">{{statOngoing}}</view>
      <view class="my-stat-label">进行中</view>
    </view>
    <view class="my-stat">
      <view class="my-stat-value num">{{statDone}}</view>
      <view class="my-stat-label">已完成</view>
    </view>
    <view class="my-stat">
      <view class="my-stat-value num">{{statWeight}}</view>
      <view class="my-stat-label">累计 kg</view>
    </view>
  </view>

  <view class="my-segments fade-up delay-2">
    <view class="my-seg-track">
      <view class="my-seg-thumb" style="transform: translateX({{segmentIndex * 100}}%);"></view>
      <view wx:for="{{segments}}" wx:key="value" class="my-segment {{segment === item.value ? 'active' : ''}}" data-value="{{item.value}}" data-index="{{index}}" bindtap="selectSegment">{{item.label}}</view>
    </view>
    <view class="my-segment my-segment-search {{hasSearchFilters ? 'filtered' : ''}}" bindtap="openSearchPanel">
      <ap-icon name="search" size="{{24}}" stroke="{{2.2}}" color="{{hasSearchFilters ? '#1c1c1a' : 'ink-2'}}" />
      <text>搜索</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="my-skeleton">
    <view wx:for="{{[0, 1, 2, 3]}}" wx:key="*this" class="my-skeleton-ticket skeleton-shine"></view>
  </view>

  <view wx:elif="{{bindings.length}}" class="my-tickets">
    <view wx:for="{{bindings}}" wx:key="_id" class="ticket list-enter" style="animation-delay: {{index < 8 ? 120 + index * 40 : 0}}ms" hover-class="ticket-press" hover-start-time="20" hover-stay-time="90" data-id="{{item._id}}" bindtap="openBindingDetail">
      <view class="ticket-stub">
        <view class="ticket-day num">{{item.day.day}}</view>
        <view class="ticket-month">{{item.day.month}}</view>
      </view>
      <view class="ticket-main">
        <view class="ticket-route">{{item.routeText}}</view>
        <view class="ticket-meta">
          <view class="tag tag-{{item.statusTone}}">{{item.statusText}}</view>
          <text class="tag-code">#{{item.bagNo}}</text>
        </view>
      </view>
      <view class="ticket-metric"><text class="num">{{item.metricValue}}</text><text class="ticket-unit">{{item.metricUnit}}</text></view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="empty-art"><ap-art name="suitcase" width="{{240}}" height="{{180}}" /></view>
    <view>{{emptyMessage}}</view>
  </view>

  <view wx:if="{{searchPanelOpen}}" class="my-search-drawer {{searchPanelClosing ? 'closing' : ''}}">
    <view class="my-search-mask sheet-mask-anim" bindtap="closeSearchPanel"></view>
    <view class="my-search-sheet sheet-panel-anim">
      <view class="sheet-grab"></view>
      <view class="my-search-sheet-header">
        <view class="my-search-sheet-title">搜索我的袋子</view>
        <button class="my-search-close" bindtap="closeSearchPanel">关闭</button>
      </view>

      <view class="my-search-panel">
        <view class="my-search-row">
          <view class="my-search-field">
            <view class="my-search-label">日期</view>
            <picker mode="date" value="{{searchFilters.departureDate}}" bindchange="onSearchDateChange">
              <view class="my-search-picker {{searchFilters.departureDate ? '' : 'placeholder'}}">{{searchFilters.departureDate || '选择日期'}}</view>
            </picker>
          </view>
          <view class="my-search-field">
            <view class="my-search-label">袋子编号</view>
            <picker mode="selector" range="{{bagOptions}}" range-key="label" value="{{bagIndex}}" bindchange="onSearchBagChange">
              <view class="my-search-picker {{searchFilters.bagNo ? '' : 'placeholder'}}">{{searchFilters.bagNo || '全部编号'}}</view>
            </picker>
          </view>
        </view>

        <view class="my-search-row">
          <view class="my-search-field">
            <view class="my-search-label">出发地</view>
            <input class="my-search-input" value="{{searchFilters.fromCity}}" data-field="fromCity" bindinput="onSearchInput" placeholder="输入出发地" />
          </view>
          <view class="my-search-field">
            <view class="my-search-label">目的地</view>
            <input class="my-search-input" value="{{searchFilters.toCity}}" data-field="toCity" bindinput="onSearchInput" placeholder="输入目的地" />
          </view>
        </view>

        <button class="my-clear-search" bindtap="clearSearchFilters">清空搜索</button>
      </view>
    </view>
  </view>
</view>
