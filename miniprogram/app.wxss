page {
  /* Motion */
  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --dur-fast: 160ms;
  --dur-base: 260ms;
  --dur-slow: 380ms;

  /* Colour: paper + ink, yellow only as an accent, one warm grey */
  --paper: #fffefa;
  --card: #ffffff;
  --fill: #f4f3ee;
  --line: rgba(28, 28, 26, 0.08);
  --line-strong: rgba(28, 28, 26, 0.16);
  --ink: #1c1c1a;
  --ink-2: #55534c;
  --ink-3: #9a978c;
  --yellow: #fff51f;
  --yellow-soft: #fff9b8;
  --green: #3f6a1d;
  --green-bg: #e8f3df;
  --red: #b3261e;

  /* Shape */
  --r-s: 12rpx;
  --r-m: 20rpx;
  --r-l: 28rpx;
  --shadow: 0 24rpx 48rpx -32rpx rgba(28, 28, 26, 0.4);

  /* Type: numbers use a narrow face where the system has one */
  --font-num: "DIN Alternate", "DIN Condensed", "Roboto Condensed", "sans-serif-condensed", "Helvetica Neue", Arial, sans-serif;

  min-height: 100vh;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

button {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: inherit;
  text-align: center;
}

button::after {
  border: none;
}

button {
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}

.button-hover {
  opacity: 0.82;
  transform: scale(0.97);
}

.num {
  font-family: var(--font-num);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.01em;
}

.eyebrow {
  color: var(--ink-3);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.page.no-bottom-nav {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.page-title,
.detail-page-title {
  margin: 8rpx 0 28rpx;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.01em;
}

.page-eyebrow {
  margin-top: 8rpx;
}

.page-eyebrow + .page-title {
  margin-top: 6rpx;
}

.page-subtitle {
  margin: -14rpx 0 32rpx;
  max-width: 620rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 40rpx 4rpx 16rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.visual-divider {
  height: 1rpx;
  margin: 28rpx -32rpx;
  background: var(--line);
}

.card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.card-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muted {
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx -8rpx 0;
}

.meta-item {
  box-sizing: border-box;
  min-width: 0;
  width: 50%;
  padding: 12rpx 8rpx 0;
}

.meta-label {
  color: var(--ink-3);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.meta-value {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-word;
}

/* ---------- Status tags (one palette for the whole app, admin included) ---------- */

.pill,
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--ink-2);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.pill {
  background: var(--yellow);
  color: var(--ink);
}

.pill.gray {
  background: var(--fill);
  color: var(--ink-2);
}

.tag-wait {
  background: var(--yellow);
  color: var(--ink);
}

.tag-ok,
.tag-done {
  background: var(--green-bg);
  color: var(--green);
}

.tag-progress {
  background: var(--fill);
  color: var(--ink-2);
}

.tag-off {
  background: var(--fill);
  color: var(--ink-3);
  text-decoration: line-through;
}

.tag-code {
  background: transparent;
  padding: 0;
  color: var(--ink-3);
  font-family: var(--font-num);
  font-size: 22rpx;
  letter-spacing: 0.04em;
}

/* ---------- Form fields: white box, hairline, label inside ---------- */

.form {
  margin-top: 22rpx;
}

.field {
  position: relative;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 18rpx 24rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-m);
  background: var(--card);
  transition: border-color var(--dur-fast) ease, box-shadow var(--dur-base) var(--ease-out);
}

.field.focused {
  border-color: var(--ink);
  box-shadow: 0 0 0 6rpx rgba(255, 245, 31, 0.55);
}

.field-label {
  margin-bottom: 6rpx;
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.4;
}

.field-hint {
  margin-top: 10rpx;
  color: var(--ink-3);
  font-size: 21rpx;
  line-height: 1.5;
}

.input,
.textarea,
.picker-value,
.fixed-value {
  box-sizing: border-box;
  width: 100%;
  min-height: 48rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
}

.input {
  height: 48rpx;
}

.fixed-value {
  color: var(--ink-2);
}

.textarea {
  min-height: 112rpx;
  height: 112rpx;
}

.placeholder {
  color: #c4c2b9;
}

/* ---------- Buttons ---------- */

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  border-radius: var(--r-l);
  font-size: 28rpx;
  font-weight: 600;
}

.primary-button {
  background: var(--ink);
  color: #ffffff;
}

.primary-button[disabled] {
  background: #b9b7ae;
  color: #ffffff;
}

.primary-button .button-num {
  color: var(--yellow);
  font-family: var(--font-num);
  font-size: 32rpx;
  font-weight: 700;
}

.primary-button.success,
.primary-button.success[disabled] {
  background: var(--yellow);
  color: var(--ink);
  animation: ap-pop 360ms var(--ease-spring);
}

.secondary-button {
  border: 1rpx solid var(--line-strong);
  background: var(--card);
  color: var(--ink);
}

.secondary-button[disabled] {
  border-color: var(--line);
  background: var(--fill);
  color: var(--ink-3);
}

.danger-button {
  border: 1rpx solid rgba(179, 38, 30, 0.24);
  background: var(--card);
  color: var(--red);
}

.empty-state {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 44rpx 32rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--r-l);
  background: transparent;
  color: var(--ink-3);
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.choice-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 6rpx;
}

.choice-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  background: var(--card);
  color: var(--ink-2);
  font-size: 23rpx;
  font-weight: 500;
}

.choice-pill {
  transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
}

.choice-pill.active {
  border-color: var(--ink);
  background: var(--ink);
  color: #ffffff;
  animation: ap-pop 320ms var(--ease-spring);
}

.route-line {
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

/* ---------- Info list (label left, value right) used under the boarding pass ---------- */

.info-list {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx;
}

.info-row + .info-row {
  border-top: 1rpx solid var(--line);
}

.info-label {
  flex: 0 0 auto;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 25rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-word;
}

.info-note {
  padding: 22rpx 28rpx 26rpx;
  border-top: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- Icon list rows (home, offer space) ---------- */

.icon-list {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--r-l);
  background: var(--card);
}

.icon-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  transition: background var(--dur-fast) ease;
}

.icon-row + .icon-row {
  border-top: 1rpx solid var(--line);
}

.icon-row-press {
  background: var(--fill);
}

.icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--fill);
}

.icon-row-copy {
  flex: 1;
  min-width: 0;
}

.icon-row-title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.icon-row-desc {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.4;
}

/* ---------- Shared blocks ---------- */

.empty-art {
  display: block;
  width: 120rpx;
  height: 133rpx;
  margin: 4rpx auto 18rpx;
  opacity: 0.85;
  animation: ap-float 3.6s ease-in-out infinite;
}

/* Fixed bottom action bar for long forms; the page adds .has-sticky-action. */
.page.has-sticky-action {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.sticky-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 40rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(rgba(255, 254, 250, 0), var(--paper) 40%);
}

.sticky-action .primary-button {
  margin-top: 0;
}

.form-group-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 4rpx 16rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.form-group-title:first-child {
  margin-top: 8rpx;
}

.count-swap {
  display: inline-block;
  animation: ap-fade-up var(--dur-base) var(--ease-out) backwards;
}

/* ---------- Motion ---------- */

.fade-up {
  animation: ap-fade-up var(--dur-slow) var(--ease-out) backwards;
}

.fade-up.delay-1 {
  animation-delay: 60ms;
}

.fade-up.delay-2 {
  animation-delay: 120ms;
}

.fade-up.delay-3 {
  animation-delay: 180ms;
}

/* Plays once when a list item is created; kept nodes (same wx:key) do not replay. */
.list-enter {
  animation: ap-list-enter var(--dur-slow) var(--ease-out) backwards;
}

.row-press {
  background: rgba(0, 0, 0, 0.05);
}

.skeleton-shine {
  position: relative;
  overflow: hidden;
}

.skeleton-shine::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(100deg, rgba(255, 255, 255, 0) 30%, rgba(255, 255, 255, 0.7) 50%, rgba(255, 255, 255, 0) 70%);
  transform: translateX(-100%);
  animation: ap-shine 1.2s ease-in-out infinite;
}

.sheet-grab {
  width: 68rpx;
  height: 8rpx;
  margin: -10rpx auto 20rpx;
  border-radius: 8rpx;
  background: var(--line-strong);
}

.sheet-mask-anim {
  animation: ap-mask-in var(--dur-base) linear both;
}

.sheet-panel-anim {
  animation: ap-sheet-in var(--dur-slow) var(--ease-out) both;
}

.closing .sheet-mask-anim {
  animation: ap-mask-out 220ms linear both;
}

.closing .sheet-panel-anim {
  animation: ap-sheet-out 240ms var(--ease-in) both;
}

@keyframes ap-fade-up {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ap-list-enter {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ap-pop {
  40% {
    transform: scale(1.08);
  }
}

@keyframes ap-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

@keyframes ap-bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6rpx);
  }
}

@keyframes ap-scale-in {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes ap-slide-in {
  from {
    opacity: 0;
    transform: translateX(-24rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes ap-draw-line {
  from {
    transform: scaleY(0);
  }
  to {
    transform: scaleY(1);
  }
}

@keyframes ap-shine {
  to {
    transform: translateX(100%);
  }
}

@keyframes ap-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes ap-mask-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes ap-sheet-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes ap-sheet-out {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}
