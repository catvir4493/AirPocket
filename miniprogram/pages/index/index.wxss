.landing-page {
  padding-top: 40rpx;
}

.home-pattern {
  display: flex;
  justify-content: center;
  padding: 28rpx 18rpx 8rpx;
}

.home-pattern-art {
  width: 520rpx;
  height: 268rpx;
}

.home-logo-wrap {
  display: flex;
  justify-content: center;
  padding: 60rpx 0 48rpx;
}

.home-logo-block {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.home-logo-image {
  width: 430rpx;
  height: 98rpx;
}

.home-logo-subtitle {
  margin-top: 14rpx;
  color: #555555;
  font-size: 23rpx;
  line-height: 1.25;
  text-align: center;
}

.home-logo-cn {
  margin-top: 5rpx;
  color: #9b9b9b;
  font-size: 21rpx;
  line-height: 1.25;
  text-align: center;
}

.home-menu {
  padding-top: 28rpx;
  padding-left: 34rpx;
  border-top: 1rpx solid #eeeeee;
}

.home-menu-title {
  margin-bottom: 28rpx;
  color: #606060;
  font-size: 28rpx;
  font-weight: 800;
}

.home-menu-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0 28rpx;
}

.home-menu-item::after {
  content: "";
  position: absolute;
  top: 23rpx;
  bottom: -23rpx;
  left: 5rpx;
  width: 1rpx;
  background: rgba(34, 34, 34, 0.18);
}

.home-menu-item:last-child::after {
  display: none;
}

.home-menu-dot {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin: 16rpx 28rpx 0 0;
  border-radius: 50%;
  background: #222222;
  transition: transform var(--dur-fast) var(--ease-spring);
}

.home-menu-copy {
  flex: 1;
  min-width: 0;
  transition: transform var(--dur-fast) var(--ease-out);
}

.menu-item-press .home-menu-dot {
  transform: scale(1.6);
}

.menu-item-press .home-menu-copy {
  transform: translateX(6rpx);
}

.home-menu-name {
  color: #353535;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.25;
}

.home-menu-desc {
  margin-top: 8rpx;
  color: #9a9a9a;
  font-size: 23rpx;
  line-height: 1.35;
}
